import sh.sysl.blas.*
import sh.sysl.cblas.{Oracle, Lib, libs}
import sysl.slices.{as_mut_ptr, sort_by}
import sysl.time.monotonic
import sysl.hint.black_box
import sysl.buf.{Buf, buf}

// Every contiguous Level 1 routine of sh.sysl.blas against Accelerate and OpenBLAS, at a size that
// lives in L1, one in L2, and one in main memory. The three implementations are timed in turn
// within each trial, so a change in the machine's load lands on all three alike, and the figure
// reported is the median of the trials. Each trial is about `work` elements, so the microsecond
// clock is never what is measured.
//
// The unit is GB/s of vector data each call reads and writes (`bytes` below), which puts the
// arithmetic routines and the moving ones on one scale. For `dot` and `axpy` it is GFLOPS times
// `sizeof(T)` times 1.5 and 1 respectively.

private val sizes: [3]usize = [1024, 262144, 4194304]

private val places: [3]string = ["L1", "L2", "DRAM"]

private const trials = 7

/** About this many elements per trial. */
private const work: f64 = 1e8

enum Op
    Dot
    Axpy
    Scal
    Asum
    Nrm2
    Iamax
    Copy
    Swap
    Rot

private val ops: [9]Op = [Op.Dot, Op.Axpy, Op.Scal, Op.Asum, Op.Nrm2, Op.Iamax, Op.Copy, Op.Swap, Op.Rot]

impl Op
    name(self) -> string = self match
        Dot -> "dot"
        Axpy -> "axpy"
        Scal -> "scal"
        Asum -> "asum"
        Nrm2 -> "nrm2"
        Iamax -> "iamax"
        Copy -> "copy"
        Swap -> "swap"
        Rot -> "rot"

    /** Vectors read plus vectors written per element. */
    streams(self) -> usize = self match
        Asum | Nrm2 | Iamax -> 1
        Dot | Scal | Copy -> 2
        Axpy -> 3
        Swap | Rot -> 4

private fill[T: Oracle](n: usize) -> Buf[T]
    var b: Buf[T] = buf()
    for i in 0..<n
        b.push(T.from_unit(f64(i % 17) * 0.0625 - 0.5))
    b

/** One call of `op` on `x` and `y` by implementation `who`: 0 is sysl, then `libs` in order.
 *
 * `scal` multiplies by a number a hair above one (and representable as more than one in f32), because
 * both libraries return at once for exactly one; `rot` turns by a rotation; neither drifts towards
 * overflow over a run.
 */
private once[T: Oracle](op: Op, who: usize, xs: []T, ys: []T)
    val alpha = T.from_unit(1e-9)
    val grow = T.from_unit(1 + 0x1p-20)
    val c = T.from_unit(0.6)
    val s = T.from_unit(0.8)
    if who == 0
        op match
            Dot -> _ = black_box(dot(view(xs), view(ys)))
            Axpy -> axpy(alpha, view(xs), view_mut(ys))
            Scal -> scal(grow, view_mut(xs))
            Asum -> _ = black_box(asum(view(xs)))
            Nrm2 -> _ = black_box(nrm2(view(xs)))
            Iamax -> _ = black_box(iamax(view(xs)))
            Copy -> copy(view(xs), view_mut(ys))
            Swap -> swap(view_mut(xs), view_mut(ys))
            Rot -> rot(view_mut(xs), view_mut(ys), c, s)
        return
    val lib = libs[who - 1]
    val n = i32(xs.len)
    val px = as_mut_ptr(xs)
    val py = as_mut_ptr(ys)
    op match
        Dot -> _ = black_box(T.o_dot(lib, n, px, 1, py, 1))
        Axpy -> T.o_axpy(lib, n, alpha, px, 1, py, 1)
        Scal -> T.o_scal(lib, n, grow, px, 1)
        Asum -> _ = black_box(T.o_asum(lib, n, px, 1))
        Nrm2 -> _ = black_box(T.o_nrm2(lib, n, px, 1))
        Iamax -> _ = black_box(T.o_iamax(lib, n, px, 1))
        Copy -> T.o_copy(lib, n, px, 1, py, 1)
        Swap -> T.o_swap(lib, n, px, 1, py, 1)
        Rot -> T.o_rot(lib, n, px, 1, py, 1, c, s)

private median(xs: []f64) -> f64
    sort_by(xs, (a, b) -> a < b)
    xs[xs.len / 2]

private bench_width[T: Oracle](name: string)
    for k in 0..<sizes.len
        val n = sizes[k]
        var x = fill[T](n)
        var y = fill[T](n)
        val reps = int(work / f64(n)) + 1
        for op in ops
            var rates: [3][trials]f64
            for t in 0..<trials
                for who in 0..<3
                    val t0 = monotonic().us
                    for _ in 0..<reps
                        once(op, who, black_box(x.view()), black_box(y.view()))
                    val dt = f64(monotonic().us - t0) * 1e-6
                    rates[who][t] = f64(op.streams() * sizeof(T) * n) * f64(reps) / dt * 1e-9
            val ours = median(rates[0][..])
            val acc = median(rates[1][..])
            val ob = median(rates[2][..])
            print(f"| ${name} | ${op.name()} | ${places[k]} ${n} | ${ours}%.1f | ${acc}%.1f | ${ob}%.1f | ${100.0 * ours / acc}%.0f | ${100.0 * ours / ob}%.0f |")

// --- gemm ------------------------------------------------------------------------------------------

/** Square gemm sizes: L1-resident up to well past every cache. */
private val gemm_sizes: [6]usize = [64, 128, 256, 512, 1024, 2048]

/** About this many flops per trial, so a small size repeats and a large one runs once. */
private const gemm_work: f64 = 4e9

/** One `c := a * b + c` of `n` x `n` column-major matrices by implementation `who`, 0 being sysl;
 * sysl packs into `pa` and `pb`, allocated once outside the timing as the caller-supplied form allows.
 */
private gemm_once[T: Oracle](who: usize, n: usize, a: []T, b: []T, c: []T, pa: []T, pb: []T)
    val one = T.one()
    if who == 0
        gemm(one, matrix(a, n, n, n), matrix(b, n, n, n), one, matrix_mut(c, n, n, n), GemmWork(pa, pb))
        return
    val nn = i32(n)
    T.o_gemm(libs[who - 1], false, false, nn, nn, nn, one, as_mut_ptr(a), nn, as_mut_ptr(b), nn, one, as_mut_ptr(c), nn)

private bench_gemm[T: Oracle](name: string)
    for n in gemm_sizes
        val a = fill[T](n * n)
        val b = fill[T](n * n)
        val c = fill[T](n * n)
        val len = gemm_work_len[T](n, n, n)
        val pa = fill[T](len.a)
        val pb = fill[T](len.b)
        val flops = 2.0 * f64(n) * f64(n) * f64(n)
        val reps = int(gemm_work / flops) + 1
        var rates: [3][trials]f64
        for t in 0..<trials
            for who in 0..<3
                val t0 = monotonic().us
                for _ in 0..<reps
                    gemm_once(who, n, black_box(a.view()), black_box(b.view()), black_box(c.view()), pa.view(), pb.view())
                val dt = f64(monotonic().us - t0) * 1e-6
                rates[who][t] = flops * f64(reps) / dt * 1e-9
        val ours = median(rates[0][..])
        val acc = median(rates[1][..])
        val ob = median(rates[2][..])
        print(f"| ${name} | gemm | ${n} | ${ours}%.1f | ${acc}%.1f | ${ob}%.1f | ${100.0 * ours / acc}%.0f | ${100.0 * ours / ob}%.0f |")

// --- trsm ------------------------------------------------------------------------------------------

/** One `b := a⁻¹ b` with `a` lower triangular, non-unit, `n` x `n` like `b`, by implementation `who`. */
private trsm_once[T: Oracle](who: usize, n: usize, a: []T, b: []T, pa: []T, pb: []T)
    if who == 0
        trsm(Side.Left, Uplo.Lower, Diag.NonUnit, T.one(), matrix(a, n, n, n), matrix_mut(b, n, n, n), GemmWork(pa, pb))
        return
    val nn = i32(n)
    T.o_trsm(libs[who - 1], false, false, false, false, nn, nn, T.one(), as_mut_ptr(a), nn, as_mut_ptr(b), nn)

private bench_trsm[T: Oracle](name: string)
    for n in gemm_sizes
        val a = fill[T](n * n)
        for i in 0..<n
            a[i + i * n] = T.from_unit(f64(n))
        val b0 = fill[T](n * n)
        val b = fill[T](n * n)
        val len = trsm_work_len[T](Side.Left, n, n)
        val pa = fill[T](len.a)
        val pb = fill[T](len.b)
        // n² flops per right-hand side: n³ in all.
        val flops = f64(n) * f64(n) * f64(n)
        val reps = int(gemm_work / flops) + 1
        var rates: [3][trials]f64
        for t in 0..<trials
            for who in 0..<3
                val t0 = monotonic().us
                for _ in 0..<reps
                    // The solve is in place: every repetition starts again from the same B, so none
                    // solves numbers shrunk toward the subnormal range. The copy (n² of n³) is timed
                    // for all three alike.
                    for i in 0..<b.len()
                        b[i] = b0[i]
                    trsm_once(who, n, black_box(a.view()), black_box(b.view()), pa.view(), pb.view())
                val dt = f64(monotonic().us - t0) * 1e-6
                rates[who][t] = flops * f64(reps) / dt * 1e-9
        val ours = median(rates[0][..])
        val acc = median(rates[1][..])
        val ob = median(rates[2][..])
        print(f"| ${name} | trsm | ${n} | ${ours}%.1f | ${acc}%.1f | ${ob}%.1f | ${100.0 * ours / acc}%.0f | ${100.0 * ours / ob}%.0f |")

// --- Level 2 ---------------------------------------------------------------------------------------
//
// Square column-major matrices whose storage (at f64) fits L1, fits L2, and lives in main memory. The
// unit is GFLOPS, 2mn per call for each routine; `gemv T` is `gemv` on `a.t()`, CBLAS's `trans = 'T'`.

private val dims: [3]usize = [48, 256, 2048]

enum Op2
    GemvN
    GemvT
    Ger

private val ops2: [3]Op2 = [Op2.GemvN, Op2.GemvT, Op2.Ger]

impl Op2
    name(self) -> string = self match
        GemvN -> "gemv N"
        GemvT -> "gemv T"
        Ger -> "ger"

/** One call of `op` by implementation `who`. `ger` adds a tiny multiple, so `a` does not drift. */
private once2[T: Oracle](op: Op2, who: usize, n: usize, a: []T, x: []T, y: []T)
    val one = T.one()
    val tiny = T.from_unit(1e-9)
    if who == 0
        op match
            GemvN -> gemv(one, matrix(a, n, n, n), view(x), one, view_mut(y))
            GemvT -> gemv(one, matrix(a, n, n, n).t(), view(x), one, view_mut(y))
            Ger -> ger(tiny, view(x), view(y), matrix_mut(a, n, n, n))
        return
    val lib = libs[who - 1]
    val nn = i32(n)
    op match
        GemvN -> T.o_gemv(lib, false, nn, nn, one, as_mut_ptr(a), nn, as_mut_ptr(x), 1, one, as_mut_ptr(y), 1)
        GemvT -> T.o_gemv(lib, true, nn, nn, one, as_mut_ptr(a), nn, as_mut_ptr(x), 1, one, as_mut_ptr(y), 1)
        Ger -> T.o_ger(lib, nn, nn, tiny, as_mut_ptr(x), 1, as_mut_ptr(y), 1, as_mut_ptr(a), nn)

private bench_level2[T: Oracle](name: string)
    for k in 0..<dims.len
        val n = dims[k]
        var a = fill[T](n * n)
        var x = fill[T](n)
        var y = fill[T](n)
        val reps = int(work / f64(n * n)) + 1
        for op in ops2
            var rates: [3][trials]f64
            for t in 0..<trials
                for who in 0..<3
                    val t0 = monotonic().us
                    for _ in 0..<reps
                        once2(op, who, n, black_box(a.view()), black_box(x.view()), black_box(y.view()))
                    val dt = f64(monotonic().us - t0) * 1e-6
                    rates[who][t] = 2 * f64(n * n) * f64(reps) / dt * 1e-9
                    // gemv accumulates into y, so it is reset, outside the clock, after each run.
                    for i in 0..<n
                        y.view()[i] = T.from_unit(f64(i % 17) * 0.0625 - 0.5)
            val ours = median(rates[0][..])
            val acc = median(rates[1][..])
            val ob = median(rates[2][..])
            print(f"| ${name} | ${op.name()} | ${places[k]} ${n}x${n} | ${ours}%.1f | ${acc}%.1f | ${ob}%.1f | ${100.0 * ours / acc}%.0f | ${100.0 * ours / ob}%.0f |")

/** With no argument, Levels 1 and 2; with `gemm` or `trsm`, that routine alone. */
main(args: []string)
    if args.len > 1 && args[1] == "gemm"
        print(f"GFLOPS, square column-major C += A * B, median of ${trials} interleaved trials: sysl, Accelerate, OpenBLAS, and sysl as % of each")
        print("| type | routine | n | sysl | Accelerate | OpenBLAS | % Acc | % OB |")
        print("|---|---|---|---:|---:|---:|---:|---:|")
        bench_gemm[f64]("f64")
        bench_gemm[f32]("f32")
        return
    if args.len > 1 && args[1] == "trsm"
        print(f"GFLOPS (n³ per call), square column-major B := A⁻¹ B, A lower non-unit, median of ${trials} interleaved trials: sysl, Accelerate, OpenBLAS, and sysl as % of each")
        print("| type | routine | n | sysl | Accelerate | OpenBLAS | % Acc | % OB |")
        print("|---|---|---|---:|---:|---:|---:|---:|")
        bench_trsm[f64]("f64")
        bench_trsm[f32]("f32")
        return
    print(f"GB/s, median of ${trials} interleaved trials: sysl, Accelerate, OpenBLAS, and sysl as % of each")
    print("| type | routine | size | sysl | Accelerate | OpenBLAS | % Acc | % OB |")
    print("|---|---|---|---:|---:|---:|---:|---:|")
    bench_width[f64]("f64")
    bench_width[f32]("f32")
    print("")
    print(f"Level 2, GFLOPS (2mn per call), median of ${trials} interleaved trials")
    print("| type | routine | size | sysl | Accelerate | OpenBLAS | % Acc | % OB |")
    print("|---|---|---|---:|---:|---:|---:|---:|")
    bench_level2[f64]("f64")
    bench_level2[f32]("f32")
