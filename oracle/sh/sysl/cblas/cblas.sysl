module sh.sysl.cblas
@link("cblas")

import sh.sysl.blas.Real

// The Level 1 routines of the platform's CBLAS — Accelerate on macOS, where libcblas resolves into
// vecLib — declared for the checks and the benchmarks to measure sh.sysl.blas against. A CBLAS
// pointer is the lowest address a vector covers, whatever the sign of its stride.

extern "cblas_ddot" c_ddot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32) -> f64
extern "cblas_sdot" c_sdot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32) -> f32
extern "cblas_daxpy" c_daxpy(n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32)
extern "cblas_saxpy" c_saxpy(n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32)
extern "cblas_dnrm2" c_dnrm2(n: i32, x: *f64, incx: i32) -> f64
extern "cblas_snrm2" c_snrm2(n: i32, x: *f32, incx: i32) -> f32
extern "cblas_dasum" c_dasum(n: i32, x: *f64, incx: i32) -> f64
extern "cblas_sasum" c_sasum(n: i32, x: *f32, incx: i32) -> f32
extern "cblas_dscal" c_dscal(n: i32, alpha: f64, x: *f64, incx: i32)
extern "cblas_sscal" c_sscal(n: i32, alpha: f32, x: *f32, incx: i32)
extern "cblas_dcopy" c_dcopy(n: i32, x: *f64, incx: i32, y: *f64, incy: i32)
extern "cblas_scopy" c_scopy(n: i32, x: *f32, incx: i32, y: *f32, incy: i32)
extern "cblas_dswap" c_dswap(n: i32, x: *f64, incx: i32, y: *f64, incy: i32)
extern "cblas_sswap" c_sswap(n: i32, x: *f32, incx: i32, y: *f32, incy: i32)
extern "cblas_drot" c_drot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32, c: f64, s: f64)
extern "cblas_srot" c_srot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32, c: f32, s: f32)
extern "cblas_drotg" c_drotg(a: *f64, b: *f64, c: *f64, s: *f64)
extern "cblas_srotg" c_srotg(a: *f32, b: *f32, c: *f32, s: *f32)
extern "cblas_idamax" c_idamax(n: i32, x: *f64, incx: i32) -> i32
extern "cblas_isamax" c_isamax(n: i32, x: *f32, incx: i32) -> i32

/** One width's CBLAS entry points, so a check or a benchmark is written once for both widths. */
trait Oracle: Real
    from_unit(u: f64) -> Self
    o_dot(n: i32, x: *Self, incx: i32, y: *Self, incy: i32) -> Self
    o_axpy(n: i32, alpha: Self, x: *Self, incx: i32, y: *Self, incy: i32)
    o_nrm2(n: i32, x: *Self, incx: i32) -> Self
    o_asum(n: i32, x: *Self, incx: i32) -> Self
    o_scal(n: i32, alpha: Self, x: *Self, incx: i32)
    o_copy(n: i32, x: *Self, incx: i32, y: *Self, incy: i32)
    o_swap(n: i32, x: *Self, incx: i32, y: *Self, incy: i32)
    o_rot(n: i32, x: *Self, incx: i32, y: *Self, incy: i32, c: Self, s: Self)
    o_rotg(a: *Self, b: *Self, c: *Self, s: *Self)
    o_iamax(n: i32, x: *Self, incx: i32) -> i32

impl Oracle for f64
    from_unit(u: f64) -> f64 = u
    o_dot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32) -> f64 = c_ddot(n, x, incx, y, incy)
    o_axpy(n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32) = c_daxpy(n, alpha, x, incx, y, incy)
    o_nrm2(n: i32, x: *f64, incx: i32) -> f64 = c_dnrm2(n, x, incx)
    o_asum(n: i32, x: *f64, incx: i32) -> f64 = c_dasum(n, x, incx)
    o_scal(n: i32, alpha: f64, x: *f64, incx: i32) = c_dscal(n, alpha, x, incx)
    o_copy(n: i32, x: *f64, incx: i32, y: *f64, incy: i32) = c_dcopy(n, x, incx, y, incy)
    o_swap(n: i32, x: *f64, incx: i32, y: *f64, incy: i32) = c_dswap(n, x, incx, y, incy)
    o_rot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32, c: f64, s: f64) = c_drot(n, x, incx, y, incy, c, s)
    o_rotg(a: *f64, b: *f64, c: *f64, s: *f64) = c_drotg(a, b, c, s)
    o_iamax(n: i32, x: *f64, incx: i32) -> i32 = c_idamax(n, x, incx)

impl Oracle for f32
    from_unit(u: f64) -> f32 = f32(u)
    o_dot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32) -> f32 = c_sdot(n, x, incx, y, incy)
    o_axpy(n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32) = c_saxpy(n, alpha, x, incx, y, incy)
    o_nrm2(n: i32, x: *f32, incx: i32) -> f32 = c_snrm2(n, x, incx)
    o_asum(n: i32, x: *f32, incx: i32) -> f32 = c_sasum(n, x, incx)
    o_scal(n: i32, alpha: f32, x: *f32, incx: i32) = c_sscal(n, alpha, x, incx)
    o_copy(n: i32, x: *f32, incx: i32, y: *f32, incy: i32) = c_scopy(n, x, incx, y, incy)
    o_swap(n: i32, x: *f32, incx: i32, y: *f32, incy: i32) = c_sswap(n, x, incx, y, incy)
    o_rot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32, c: f32, s: f32) = c_srot(n, x, incx, y, incy, c, s)
    o_rotg(a: *f32, b: *f32, c: *f32, s: *f32) = c_srotg(a, b, c, s)
    o_iamax(n: i32, x: *f32, incx: i32) -> i32 = c_isamax(n, x, incx)
