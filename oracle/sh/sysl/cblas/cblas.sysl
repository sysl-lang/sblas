module sh.sysl.cblas
@link("cblas")

import sh.sysl.sblas.Real

// The Level 1 and Level 2 routines of two CBLAS implementations, declared for the checks and the benchmarks to
// measure sh.sysl.sblas against: the platform's (Accelerate on macOS, where libcblas resolves into
// vecLib) and OpenBLAS. A CBLAS pointer is the lowest address a vector covers, whatever the sign of
// its stride.
//
// The two export the same names, so only Accelerate is linked; OpenBLAS is loaded at run time and
// reached through `openblas.c`, whose `sysl_ob_*` functions call OpenBLAS's own entry points.

/** Which CBLAS a call goes to. */
enum Lib
    Accelerate
    OpenBLAS

/** Both, in the order a check or a benchmark reports them. */
val libs: [2]Lib = [Lib.Accelerate, Lib.OpenBLAS]

impl Lib
    name(self) -> string = self match
        Accelerate -> "Accelerate"
        OpenBLAS -> "OpenBLAS"

extern "cblas_ddot" c_ddot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32) -> f64
extern "cblas_sdot" c_sdot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32) -> f32
extern "cblas_daxpy" c_daxpy(n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32)
extern "cblas_saxpy" c_saxpy(n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32)
extern "cblas_dnrm2" c_dnrm2(n: i32, x: *f64, incx: i32) -> f64
extern "cblas_snrm2" c_snrm2(n: i32, x: *f32, incx: i32) -> f32
extern "cblas_dasum" c_dasum(n: i32, x: *f64, incx: i32) -> f64
extern "cblas_sasum" c_sasum(n: i32, x: *f32, incx: i32) -> f32
extern "cblas_dscal" c_dscal(n: i32, alpha: f64, x: *f64, incx: i32)
extern "cblas_sscal" c_sscal(n: i32, alpha: f32, x: *f32, incx: i32)
extern "cblas_dcopy" c_dcopy(n: i32, x: *f64, incx: i32, y: *f64, incy: i32)
extern "cblas_scopy" c_scopy(n: i32, x: *f32, incx: i32, y: *f32, incy: i32)
extern "cblas_dswap" c_dswap(n: i32, x: *f64, incx: i32, y: *f64, incy: i32)
extern "cblas_sswap" c_sswap(n: i32, x: *f32, incx: i32, y: *f32, incy: i32)
extern "cblas_drot" c_drot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32, c: f64, s: f64)
extern "cblas_srot" c_srot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32, c: f32, s: f32)
extern "cblas_drotg" c_drotg(a: *f64, b: *f64, c: *f64, s: *f64)
extern "cblas_srotg" c_srotg(a: *f32, b: *f32, c: *f32, s: *f32)
extern "cblas_idamax" c_idamax(n: i32, x: *f64, incx: i32) -> i32
extern "cblas_isamax" c_isamax(n: i32, x: *f32, incx: i32) -> i32

// Levels 2 and 3. `order` and `trans` are CBLAS's enumerators: column-major is 102, no transpose
// 111, transpose 112.
private const col_major: i32 = 102

private trans_code(trans: bool) -> i32 = if trans then 112 else 111

extern "cblas_dgemv" c_dgemv(order: i32, trans: i32, m: i32, n: i32, alpha: f64, a: *f64, lda: i32, x: *f64, incx: i32, beta: f64, y: *f64, incy: i32)
extern "cblas_sgemv" c_sgemv(order: i32, trans: i32, m: i32, n: i32, alpha: f32, a: *f32, lda: i32, x: *f32, incx: i32, beta: f32, y: *f32, incy: i32)
extern "cblas_dger" c_dger(order: i32, m: i32, n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32, a: *f64, lda: i32)
extern "cblas_sger" c_sger(order: i32, m: i32, n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32, a: *f32, lda: i32)
extern "cblas_dgemm" c_dgemm(order: i32, transa: i32, transb: i32, m: i32, n: i32, k: i32, alpha: f64, a: *f64, lda: i32, b: *f64, ldb: i32, beta: f64, c: *f64, ldc: i32)
extern "cblas_sgemm" c_sgemm(order: i32, transa: i32, transb: i32, m: i32, n: i32, k: i32, alpha: f32, a: *f32, lda: i32, b: *f32, ldb: i32, beta: f32, c: *f32, ldc: i32)

private side_code(right: bool) -> i32 = if right then 142 else 141
private uplo_code(upper: bool) -> i32 = if upper then 121 else 122
private diag_code(unit: bool) -> i32 = if unit then 132 else 131

extern "cblas_dtrsm" c_dtrsm(order: i32, side: i32, uplo: i32, trans: i32, diag: i32, m: i32, n: i32, alpha: f64, a: *f64, lda: i32, b: *f64, ldb: i32)
extern "cblas_strsm" c_strsm(order: i32, side: i32, uplo: i32, trans: i32, diag: i32, m: i32, n: i32, alpha: f32, a: *f32, lda: i32, b: *f32, ldb: i32)

/** 1 when OpenBLAS's `cblas_ddot` is a different function from the one the link bound. */
@needs(os)
extern "sysl_ob_distinct" ob_distinct() -> int

/** Sets the number of threads OpenBLAS's routines use from here on; the oracle starts it at one. */
@needs(os)
extern "sysl_ob_set_threads" ob_set_threads(n: i32)

@needs(os)
extern "sysl_ob_ddot" ob_ddot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32) -> f64
@needs(os)
extern "sysl_ob_sdot" ob_sdot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32) -> f32
@needs(os)
extern "sysl_ob_daxpy" ob_daxpy(n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32)
@needs(os)
extern "sysl_ob_saxpy" ob_saxpy(n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32)
@needs(os)
extern "sysl_ob_dnrm2" ob_dnrm2(n: i32, x: *f64, incx: i32) -> f64
@needs(os)
extern "sysl_ob_snrm2" ob_snrm2(n: i32, x: *f32, incx: i32) -> f32
@needs(os)
extern "sysl_ob_dasum" ob_dasum(n: i32, x: *f64, incx: i32) -> f64
@needs(os)
extern "sysl_ob_sasum" ob_sasum(n: i32, x: *f32, incx: i32) -> f32
@needs(os)
extern "sysl_ob_dscal" ob_dscal(n: i32, alpha: f64, x: *f64, incx: i32)
@needs(os)
extern "sysl_ob_sscal" ob_sscal(n: i32, alpha: f32, x: *f32, incx: i32)
@needs(os)
extern "sysl_ob_dcopy" ob_dcopy(n: i32, x: *f64, incx: i32, y: *f64, incy: i32)
@needs(os)
extern "sysl_ob_scopy" ob_scopy(n: i32, x: *f32, incx: i32, y: *f32, incy: i32)
@needs(os)
extern "sysl_ob_dswap" ob_dswap(n: i32, x: *f64, incx: i32, y: *f64, incy: i32)
@needs(os)
extern "sysl_ob_sswap" ob_sswap(n: i32, x: *f32, incx: i32, y: *f32, incy: i32)
@needs(os)
extern "sysl_ob_drot" ob_drot(n: i32, x: *f64, incx: i32, y: *f64, incy: i32, c: f64, s: f64)
@needs(os)
extern "sysl_ob_srot" ob_srot(n: i32, x: *f32, incx: i32, y: *f32, incy: i32, c: f32, s: f32)
@needs(os)
extern "sysl_ob_drotg" ob_drotg(a: *f64, b: *f64, c: *f64, s: *f64)
@needs(os)
extern "sysl_ob_srotg" ob_srotg(a: *f32, b: *f32, c: *f32, s: *f32)
@needs(os)
extern "sysl_ob_idamax" ob_idamax(n: i32, x: *f64, incx: i32) -> i32
@needs(os)
extern "sysl_ob_isamax" ob_isamax(n: i32, x: *f32, incx: i32) -> i32
@needs(os)
extern "sysl_ob_dgemv" ob_dgemv(order: i32, trans: i32, m: i32, n: i32, alpha: f64, a: *f64, lda: i32, x: *f64, incx: i32, beta: f64, y: *f64, incy: i32)
@needs(os)
extern "sysl_ob_sgemv" ob_sgemv(order: i32, trans: i32, m: i32, n: i32, alpha: f32, a: *f32, lda: i32, x: *f32, incx: i32, beta: f32, y: *f32, incy: i32)
@needs(os)
extern "sysl_ob_dger" ob_dger(order: i32, m: i32, n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32, a: *f64, lda: i32)
@needs(os)
extern "sysl_ob_sger" ob_sger(order: i32, m: i32, n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32, a: *f32, lda: i32)
@needs(os)
extern "sysl_ob_dgemm" ob_dgemm(order: i32, transa: i32, transb: i32, m: i32, n: i32, k: i32, alpha: f64, a: *f64, lda: i32, b: *f64, ldb: i32, beta: f64, c: *f64, ldc: i32)
@needs(os)
extern "sysl_ob_sgemm" ob_sgemm(order: i32, transa: i32, transb: i32, m: i32, n: i32, k: i32, alpha: f32, a: *f32, lda: i32, b: *f32, ldb: i32, beta: f32, c: *f32, ldc: i32)
@needs(os)
extern "sysl_ob_dtrsm" ob_dtrsm(order: i32, side: i32, uplo: i32, trans: i32, diag: i32, m: i32, n: i32, alpha: f64, a: *f64, lda: i32, b: *f64, ldb: i32)
@needs(os)
extern "sysl_ob_strsm" ob_strsm(order: i32, side: i32, uplo: i32, trans: i32, diag: i32, m: i32, n: i32, alpha: f32, a: *f32, lda: i32, b: *f32, ldb: i32)

/** One width's CBLAS entry points in both libraries, so a check or a benchmark is written once for
 * both widths and both libraries.
 */
trait Oracle: Real
    from_unit(u: f64) -> Self
    o_dot(lib: Lib, n: i32, x: *Self, incx: i32, y: *Self, incy: i32) -> Self
    o_axpy(lib: Lib, n: i32, alpha: Self, x: *Self, incx: i32, y: *Self, incy: i32)
    o_nrm2(lib: Lib, n: i32, x: *Self, incx: i32) -> Self
    o_asum(lib: Lib, n: i32, x: *Self, incx: i32) -> Self
    o_scal(lib: Lib, n: i32, alpha: Self, x: *Self, incx: i32)
    o_copy(lib: Lib, n: i32, x: *Self, incx: i32, y: *Self, incy: i32)
    o_swap(lib: Lib, n: i32, x: *Self, incx: i32, y: *Self, incy: i32)
    o_rot(lib: Lib, n: i32, x: *Self, incx: i32, y: *Self, incy: i32, c: Self, s: Self)
    o_rotg(lib: Lib, a: *Self, b: *Self, c: *Self, s: *Self)
    o_iamax(lib: Lib, n: i32, x: *Self, incx: i32) -> i32
    /** Column-major `gemv`: `a` is `m` x `n`, and `trans` multiplies by its transpose. */
    o_gemv(lib: Lib, trans: bool, m: i32, n: i32, alpha: Self, a: *Self, lda: i32, x: *Self, incx: i32, beta: Self, y: *Self, incy: i32)
    /** Column-major `ger`: `a` is `m` x `n`. */
    o_ger(lib: Lib, m: i32, n: i32, alpha: Self, x: *Self, incx: i32, y: *Self, incy: i32, a: *Self, lda: i32)
    /** Column-major `gemm`: op(a) is `m` x `k` and op(b) `k` x `n`; `transa` and `transb` transpose
     * the stored matrices.
     */
    o_gemm(lib: Lib, transa: bool, transb: bool, m: i32, n: i32, k: i32, alpha: Self, a: *Self, lda: i32, b: *Self, ldb: i32, beta: Self, c: *Self, ldc: i32)
    /** Column-major `trsm` on the `m` x `n` B: A is of order `m`, or `n` when it is on the `right`;
     * `upper` names the triangle of the STORED A, as CBLAS has it, and `trans` solves with its transpose.
     */
    o_trsm(lib: Lib, right: bool, upper: bool, trans: bool, unit: bool, m: i32, n: i32, alpha: Self, a: *Self, lda: i32, b: *Self, ldb: i32)

impl Oracle for f64
    from_unit(u: f64) -> f64 = u
    o_dot(lib: Lib, n: i32, x: *f64, incx: i32, y: *f64, incy: i32) -> f64 = lib match
        Accelerate -> c_ddot(n, x, incx, y, incy)
        OpenBLAS -> ob_ddot(n, x, incx, y, incy)
    o_axpy(lib: Lib, n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32) = lib match
        Accelerate -> c_daxpy(n, alpha, x, incx, y, incy)
        OpenBLAS -> ob_daxpy(n, alpha, x, incx, y, incy)
    o_nrm2(lib: Lib, n: i32, x: *f64, incx: i32) -> f64 = lib match
        Accelerate -> c_dnrm2(n, x, incx)
        OpenBLAS -> ob_dnrm2(n, x, incx)
    o_asum(lib: Lib, n: i32, x: *f64, incx: i32) -> f64 = lib match
        Accelerate -> c_dasum(n, x, incx)
        OpenBLAS -> ob_dasum(n, x, incx)
    o_scal(lib: Lib, n: i32, alpha: f64, x: *f64, incx: i32) = lib match
        Accelerate -> c_dscal(n, alpha, x, incx)
        OpenBLAS -> ob_dscal(n, alpha, x, incx)
    o_copy(lib: Lib, n: i32, x: *f64, incx: i32, y: *f64, incy: i32) = lib match
        Accelerate -> c_dcopy(n, x, incx, y, incy)
        OpenBLAS -> ob_dcopy(n, x, incx, y, incy)
    o_swap(lib: Lib, n: i32, x: *f64, incx: i32, y: *f64, incy: i32) = lib match
        Accelerate -> c_dswap(n, x, incx, y, incy)
        OpenBLAS -> ob_dswap(n, x, incx, y, incy)
    o_rot(lib: Lib, n: i32, x: *f64, incx: i32, y: *f64, incy: i32, c: f64, s: f64) = lib match
        Accelerate -> c_drot(n, x, incx, y, incy, c, s)
        OpenBLAS -> ob_drot(n, x, incx, y, incy, c, s)
    o_rotg(lib: Lib, a: *f64, b: *f64, c: *f64, s: *f64) = lib match
        Accelerate -> c_drotg(a, b, c, s)
        OpenBLAS -> ob_drotg(a, b, c, s)
    o_iamax(lib: Lib, n: i32, x: *f64, incx: i32) -> i32 = lib match
        Accelerate -> c_idamax(n, x, incx)
        OpenBLAS -> ob_idamax(n, x, incx)
    o_gemv(lib: Lib, trans: bool, m: i32, n: i32, alpha: f64, a: *f64, lda: i32, x: *f64, incx: i32, beta: f64, y: *f64, incy: i32) = lib match
        Accelerate -> c_dgemv(col_major, trans_code(trans), m, n, alpha, a, lda, x, incx, beta, y, incy)
        OpenBLAS -> ob_dgemv(col_major, trans_code(trans), m, n, alpha, a, lda, x, incx, beta, y, incy)
    o_ger(lib: Lib, m: i32, n: i32, alpha: f64, x: *f64, incx: i32, y: *f64, incy: i32, a: *f64, lda: i32) = lib match
        Accelerate -> c_dger(col_major, m, n, alpha, x, incx, y, incy, a, lda)
        OpenBLAS -> ob_dger(col_major, m, n, alpha, x, incx, y, incy, a, lda)
    o_gemm(lib: Lib, transa: bool, transb: bool, m: i32, n: i32, k: i32, alpha: f64, a: *f64, lda: i32, b: *f64, ldb: i32, beta: f64, c: *f64, ldc: i32) = lib match
        Accelerate -> c_dgemm(col_major, trans_code(transa), trans_code(transb), m, n, k, alpha, a, lda, b, ldb, beta, c, ldc)
        OpenBLAS -> ob_dgemm(col_major, trans_code(transa), trans_code(transb), m, n, k, alpha, a, lda, b, ldb, beta, c, ldc)
    o_trsm(lib: Lib, right: bool, upper: bool, trans: bool, unit: bool, m: i32, n: i32, alpha: f64, a: *f64, lda: i32, b: *f64, ldb: i32) = lib match
        Accelerate -> c_dtrsm(col_major, side_code(right), uplo_code(upper), trans_code(trans), diag_code(unit), m, n, alpha, a, lda, b, ldb)
        OpenBLAS -> ob_dtrsm(col_major, side_code(right), uplo_code(upper), trans_code(trans), diag_code(unit), m, n, alpha, a, lda, b, ldb)

impl Oracle for f32
    from_unit(u: f64) -> f32 = f32(u)
    o_dot(lib: Lib, n: i32, x: *f32, incx: i32, y: *f32, incy: i32) -> f32 = lib match
        Accelerate -> c_sdot(n, x, incx, y, incy)
        OpenBLAS -> ob_sdot(n, x, incx, y, incy)
    o_axpy(lib: Lib, n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32) = lib match
        Accelerate -> c_saxpy(n, alpha, x, incx, y, incy)
        OpenBLAS -> ob_saxpy(n, alpha, x, incx, y, incy)
    o_nrm2(lib: Lib, n: i32, x: *f32, incx: i32) -> f32 = lib match
        Accelerate -> c_snrm2(n, x, incx)
        OpenBLAS -> ob_snrm2(n, x, incx)
    o_asum(lib: Lib, n: i32, x: *f32, incx: i32) -> f32 = lib match
        Accelerate -> c_sasum(n, x, incx)
        OpenBLAS -> ob_sasum(n, x, incx)
    o_scal(lib: Lib, n: i32, alpha: f32, x: *f32, incx: i32) = lib match
        Accelerate -> c_sscal(n, alpha, x, incx)
        OpenBLAS -> ob_sscal(n, alpha, x, incx)
    o_copy(lib: Lib, n: i32, x: *f32, incx: i32, y: *f32, incy: i32) = lib match
        Accelerate -> c_scopy(n, x, incx, y, incy)
        OpenBLAS -> ob_scopy(n, x, incx, y, incy)
    o_swap(lib: Lib, n: i32, x: *f32, incx: i32, y: *f32, incy: i32) = lib match
        Accelerate -> c_sswap(n, x, incx, y, incy)
        OpenBLAS -> ob_sswap(n, x, incx, y, incy)
    o_rot(lib: Lib, n: i32, x: *f32, incx: i32, y: *f32, incy: i32, c: f32, s: f32) = lib match
        Accelerate -> c_srot(n, x, incx, y, incy, c, s)
        OpenBLAS -> ob_srot(n, x, incx, y, incy, c, s)
    o_rotg(lib: Lib, a: *f32, b: *f32, c: *f32, s: *f32) = lib match
        Accelerate -> c_srotg(a, b, c, s)
        OpenBLAS -> ob_srotg(a, b, c, s)
    o_iamax(lib: Lib, n: i32, x: *f32, incx: i32) -> i32 = lib match
        Accelerate -> c_isamax(n, x, incx)
        OpenBLAS -> ob_isamax(n, x, incx)
    o_gemv(lib: Lib, trans: bool, m: i32, n: i32, alpha: f32, a: *f32, lda: i32, x: *f32, incx: i32, beta: f32, y: *f32, incy: i32) = lib match
        Accelerate -> c_sgemv(col_major, trans_code(trans), m, n, alpha, a, lda, x, incx, beta, y, incy)
        OpenBLAS -> ob_sgemv(col_major, trans_code(trans), m, n, alpha, a, lda, x, incx, beta, y, incy)
    o_ger(lib: Lib, m: i32, n: i32, alpha: f32, x: *f32, incx: i32, y: *f32, incy: i32, a: *f32, lda: i32) = lib match
        Accelerate -> c_sger(col_major, m, n, alpha, x, incx, y, incy, a, lda)
        OpenBLAS -> ob_sger(col_major, m, n, alpha, x, incx, y, incy, a, lda)
    o_gemm(lib: Lib, transa: bool, transb: bool, m: i32, n: i32, k: i32, alpha: f32, a: *f32, lda: i32, b: *f32, ldb: i32, beta: f32, c: *f32, ldc: i32) = lib match
        Accelerate -> c_sgemm(col_major, trans_code(transa), trans_code(transb), m, n, k, alpha, a, lda, b, ldb, beta, c, ldc)
        OpenBLAS -> ob_sgemm(col_major, trans_code(transa), trans_code(transb), m, n, k, alpha, a, lda, b, ldb, beta, c, ldc)
    o_trsm(lib: Lib, right: bool, upper: bool, trans: bool, unit: bool, m: i32, n: i32, alpha: f32, a: *f32, lda: i32, b: *f32, ldb: i32) = lib match
        Accelerate -> c_strsm(col_major, side_code(right), uplo_code(upper), trans_code(trans), diag_code(unit), m, n, alpha, a, lda, b, ldb)
        OpenBLAS -> ob_strsm(col_major, side_code(right), uplo_code(upper), trans_code(trans), diag_code(unit), m, n, alpha, a, lda, b, ldb)
