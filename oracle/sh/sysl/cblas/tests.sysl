module sh.sysl.cblas
@tests

import sh.sysl.blas.*
import sysl.slices.as_mut_ptr
import sysl.buf.{Buf, buf}

// Every routine of sh.sysl.blas against the platform's CBLAS on generated data, at both widths, every
// length class the kernels distinguish, and strides of each sign. The reference values come from the
// oracle, never from this file.

// --- Data ------------------------------------------------------------------------------------------

private const cap: usize = 1024

/** The lengths the kernels treat differently: empty, one, under one step, several steps plus a tail. */
private val lengths: [7]usize = [0, 1, 2, 7, 33, 64, 257]

/** Stride pairs: both contiguous, both reversed (still the kernel path), and the walks. */
private val incs: [7](int, int) = [(1, 1), (-1, -1), (2, 3), (-2, 1), (1, -3), (-3, -2), (3, 1)]

/** A deterministic stream of values in [-scale, scale), from a 64-bit xorshift. */
struct Stream
    state: u64

impl Stream
    next(*self) -> f64
        self.state ^= self.state << 13
        self.state ^= self.state >> 7
        self.state ^= self.state << 17
        f64(self.state >> 11) * 0x1p-52 - 1

private fill[T: Oracle](xs: []T, s: *Stream, scale: f64)
    for i in 0..<xs.len
        xs[i] = T.from_unit(s.next() * scale)

private extent(n: usize, inc: int) -> usize = if n == 0 then 1 else 1 + (n - 1) * usize(inc.abs())

/** `got` is within `ulps` units of `want`'s magnitude, or of `bound` where cancellation makes that small. */
private near[T: Oracle](got: T, want: T, bound: T, ulps: T) -> bool = (got - want).abs() <= ulps * T.epsilon() * (want.abs() + bound)

// --- The checks ------------------------------------------------------------------------------------

private check_reductions[T: Oracle](lib: Lib, seed: u64)
    var s = Stream(seed)
    var xb: [cap]T
    var yb: [cap]T
    for n in lengths
        for (incx, incy) in incs
            val xs = xb[0..<extent(n, incx)]
            val ys = yb[0..<extent(n, incy)]
            fill(xs, &s, 1)
            fill(ys, &s, 1)
            val x = strided(xs, n, incx)
            val y = strided(ys, n, incy)
            val nn = i32(n)
            var bound = T.zero()
            for i in 0..<n
                bound = bound + (x.at(i) * y.at(i)).abs()
            val want = T.o_dot(lib, nn, as_mut_ptr(xs), i32(incx), as_mut_ptr(ys), i32(incy))
            assert(near(dot(x, y), want, bound, T.from_unit(f64(n + 1))), "dot")
            // CBLAS refuses a negative stride for a one-vector routine, so the oracle walks the same
            // elements forwards; for iamax that reverses the order, and the index is mirrored back.
            val ax = i32(incx.abs())
            assert(near(nrm2(x), T.o_nrm2(lib, nn, as_mut_ptr(xs), ax), T.zero(), 4), "nrm2")
            assert(near(asum(x), T.o_asum(lib, nn, as_mut_ptr(xs), ax), T.zero(), T.from_unit(f64(n + 1))), "asum")
            if n == 0
                assert(iamax(x) == None, "iamax of nothing")
            else
                val forwards = usize(T.o_iamax(lib, nn, as_mut_ptr(xs), ax))
                val want_max = if incx < 0 then n - 1 - forwards else forwards
                assert(iamax(x) == Some(want_max), "iamax")

/** Runs a two-vector update through both implementations on equal copies of the whole storage, so a
 * write between the strided elements shows up as well as a wrong one.
 */
private check_updates[T: Oracle](lib: Lib, seed: u64)
    var s = Stream(seed)
    var xa: [cap]T
    var ya: [cap]T
    var xb: [cap]T
    var yb: [cap]T
    for n in lengths
        for (incx, incy) in incs
            val lx = extent(n, incx)
            val ly = extent(n, incy)
            val nn = i32(n)
            val ix = i32(incx)
            val iy = i32(incy)
            val alpha = T.from_unit(s.next() * 4)
            val c = T.from_unit(0.6)
            val sn = T.from_unit(-0.8)
            for op in 0..<5
                fill(xa[0..<lx], &s, 1)
                fill(ya[0..<ly], &s, 1)
                for i in 0..<lx
                    xb[i] = xa[i]
                for i in 0..<ly
                    yb[i] = ya[i]
                val x = strided_mut(xa[0..<lx], n, incx)
                val y = strided_mut(ya[0..<ly], n, incy)
                val px = as_mut_ptr(xb[0..<lx])
                val py = as_mut_ptr(yb[0..<ly])
                op match
                    0 ->
                        axpy(alpha, x.as_view(), y)
                        T.o_axpy(lib, nn, alpha, px, ix, py, iy)
                    1 ->
                        scal(alpha, x)
                        T.o_scal(lib, nn, alpha, px, i32(incx.abs()))
                    2 ->
                        copy(x.as_view(), y)
                        T.o_copy(lib, nn, px, ix, py, iy)
                    3 ->
                        swap(x, y)
                        T.o_swap(lib, nn, px, ix, py, iy)
                    else
                        rot(x, y, c, sn)
                        T.o_rot(lib, nn, px, ix, py, iy, c, sn)
                for i in 0..<lx
                    assert(near(xa[i], xb[i], T.one(), 4), "x after an update")
                for i in 0..<ly
                    assert(near(ya[i], yb[i], alpha.abs() + T.one(), 4), "y after an update")

private check_rotg[T: Oracle](lib: Lib, a: T, b: T)
    var ra = a
    var rb = b
    var c = T.zero()
    var sn = T.zero()
    T.o_rotg(lib, &ra, &rb, &c, &sn)
    val g = rotg(a, b)
    assert(near(g.c, c, T.zero(), 2) && near(g.s, sn, T.zero(), 2), "rotg c and s")
    assert(near(g.r, ra, T.zero(), 2) && near(g.z, rb, T.zero(), 2), "rotg r and z")

private check_rotg_cases[T: Oracle](lib: Lib)
    val vals: [9]f64 = [0, 1, -1, 3, -4, 0.5, -2, 1e-3, 7]
    for a in vals
        for b in vals
            check_rotg(lib, T.from_unit(a), T.from_unit(b))

private check_iamax_ties[T: Oracle](lib: Lib)
    var xs: [6]T
    val vals: [6]f64 = [1, -3, 3, 2, -3, 3]
    for i in 0..<6
        xs[i] = T.from_unit(vals[i])
    // Positive strides only: CBLAS refuses a negative one here, and mirroring would move the tie.
    for inc in [1, 2, 3]
        val n = (6 - 1) / usize(inc.abs()) + 1
        val got = iamax(strided(xs[..], n, inc))
        assert(got == Some(usize(T.o_iamax(lib, i32(n), as_mut_ptr(xs[..]), i32(inc)))), "iamax tie")

// --- Level 2 ---------------------------------------------------------------------------------------

/** Shapes (rows, columns): empty either way, one element, one row or column, a few kernel steps with
 * tails both ways, and a matrix taller (then wider) than a panel at either width.
 */
private val shapes: [11](usize, usize) = [(0, 0), (0, 4), (4, 0), (1, 1), (1, 9), (9, 1), (5, 37), (37, 5), (70, 33), (4200, 3), (3, 4200)]

/** Stride pairs for x and y: both contiguous (the kernel paths), each sign, and the walks. */
private val incs2: [6](int, int) = [(1, 1), (-1, -1), (2, -3), (-2, 1), (1, 3), (3, -1)]

private const big: usize = 25300

/** Equal, or both NaN: what an element nobody should have written must still be. */
private same[T: Oracle](a: T, b: T) -> bool = a == b || (a.is_nan() && b.is_nan())

private zeros[T: Oracle](n: usize) -> Buf[T]
    var b: Buf[T] = buf()
    for _ in 0..<n
        b.push(T.zero())
    b

/** A column-major `m` x `n` matrix of values in [-1, 1) whose padding rows are NaN. */
private fill_matrix[T: Oracle](a: []T, m: usize, n: usize, lda: usize, s: *Stream)
    for j in 0..<n
        for i in 0..<lda
            a[j * lda + i] = if i < m then T.from_unit(s.next()) else T.nan()

/** Every element of the storage `got` and `want` share: covered ones within the bound, the rest untouched. */
private check_vector[T: Oracle](got: []T, want: []T, len: usize, inc: int, bounds: []T, ulps: T, what: string)
    val step = usize(inc.abs())
    for k in 0..<got.len
        if len > 0 && k % step == 0
            val i = if inc > 0 then k / step else len - 1 - k / step
            assert(same(got[k], want[k]) || near(got[k], want[k], bounds[i], ulps), what)
        else
            assert(same(got[k], want[k]), what)

/** `alpha` and `beta` as (alpha, beta): general, alpha zero, beta zero (y seeded with NaN), beta one, both. */
private val scalings: [5](f64, f64) = [(1.5, -0.75), (0, 2.5), (-2, 0), (0.5, 1), (0, 1)]

private check_gemv[T: Oracle](lib: Lib, seed: u64)
    var s = Stream(seed)
    var ab = zeros[T](big)
    var xb = zeros[T](big)
    var ya = zeros[T](big)
    var yb = zeros[T](big)
    var bounds = zeros[T](big)
    for (m, n) in shapes
        for extra in [0, 3]
            val lda = (if m == 0 then 1 else m) + usize(extra)
            val asto = ab.view()[0..<(if n == 0 then 1 else lda * n)]
            fill_matrix(asto, m, n, lda, &s)
            for trans in [false, true]
                val xl = if trans then m else n
                val yl = if trans then n else m
                val a = if trans then matrix(asto, m, n, lda).t() else matrix(asto, m, n, lda)
                for (incx, incy) in incs2
                    val xs = xb.view()[0..<extent(xl, incx)]
                    val ly = extent(yl, incy)
                    for (al, be) in scalings
                        val alpha = T.from_unit(al)
                        val beta = T.from_unit(be)
                        fill(xs, &s, 1)
                        if be == 0
                            for k in 0..<ly
                                ya.view()[k] = T.nan()
                        else
                            fill(ya.view()[0..<ly], &s, 1)
                        for k in 0..<ly
                            yb.view()[k] = ya.view()[k]
                        val x = strided(xs, xl, incx)
                        val y0 = strided(ya.view()[0..<ly], yl, incy)
                        for i in 0..<yl
                            var b = if be == 0 then T.zero() else (beta * y0.at(i)).abs()
                            for j in 0..<xl
                                b = b + (alpha * a.at(i, j) * x.at(j)).abs()
                            bounds.view()[i] = b
                        gemv(alpha, a, x, beta, strided_mut(ya.view()[0..<ly], yl, incy))
                        // With nothing to sum over, the reference BLAS and OpenBLAS return at once and
                        // leave y alone; Accelerate does too, except for the transpose of a matrix with no
                        // rows, where it scales y by beta. sh.sysl.blas follows the reference, so there y
                        // is checked against its starting value (`gemv_empty_inner` pins the divergence).
                        if !(lib == Lib.Accelerate && trans && m == 0 && n > 0)
                            T.o_gemv(lib, trans, i32(m), i32(n), alpha, as_mut_ptr(asto), i32(lda), as_mut_ptr(xs), i32(incx), beta, as_mut_ptr(yb.view()[0..<ly]), i32(incy))
                        check_vector(ya.view()[0..<ly], yb.view()[0..<ly], yl, incy, bounds.view(), T.from_unit(f64(xl + 2)), "gemv")

private check_ger[T: Oracle](lib: Lib, seed: u64)
    var s = Stream(seed)
    var aa = zeros[T](big)
    var ab = zeros[T](big)
    var xb = zeros[T](big)
    var yb = zeros[T](big)
    for (m, n) in shapes
        for extra in [0, 3]
            val lda = (if m == 0 then 1 else m) + usize(extra)
            val la = if n == 0 then 1 else lda * n
            for (incx, incy) in incs2
                val xs = xb.view()[0..<extent(m, incx)]
                val ys = yb.view()[0..<extent(n, incy)]
                for al in [1.25, 0]
                    for flip in [false, true]
                        val alpha = T.from_unit(al)
                        fill_matrix(aa.view()[0..<la], m, n, lda, &s)
                        for k in 0..<la
                            ab.view()[k] = aa.view()[k]
                        fill(xs, &s, 1)
                        fill(ys, &s, 1)
                        val x = strided(xs, m, incx)
                        val y = strided(ys, n, incy)
                        val a = matrix_mut(aa.view()[0..<la], m, n, lda)
                        if flip
                            ger(alpha, y, x, a.t())
                        else
                            ger(alpha, x, y, a)
                        T.o_ger(lib, i32(m), i32(n), alpha, as_mut_ptr(xs), i32(incx), as_mut_ptr(ys), i32(incy), as_mut_ptr(ab.view()[0..<la]), i32(lda))
                        for k in 0..<la
                            val got = aa.view()[k]
                            val want = ab.view()[k]
                            val i = k % lda
                            val j = k / lda
                            if i < m && j < n
                                val b = (alpha * x.at(i) * y.at(j)).abs() + want.abs()
                                assert(same(got, want) || near(got, want, b, 3), "ger")
                            else
                                assert(same(got, want), "ger touched the padding")

@test("gemv agrees with Accelerate and OpenBLAS at every shape, stride, transpose and scaling, f64")
oracle_gemv_f64()
    for lib in libs
        check_gemv[f64](lib, 5)

@test("with nothing to sum over, y is left as the reference leaves it, except by Accelerate's transposed gemv")
gemv_empty_inner()
    var a: [1]f64 = [9]
    var x: [1]f64 = [9]
    for trans in [false, true]
        val m = if trans then 0 else 2
        val n = if trans then 2 else 0
        var ours = [3.0, 4]
        var ob = [3.0, 4]
        var acc = [3.0, 4]
        gemv(1.0, if trans then matrix(a[0..<0], 0, 2, 1).t() else matrix(a[0..<0], 2, 0, 2), strided(x[..], 0, 1), 0.5, view_mut(ours[..]))
        f64.o_gemv(Lib.OpenBLAS, trans, m, n, 1, as_mut_ptr(a[..]), 2, as_mut_ptr(x[..]), 1, 0.5, as_mut_ptr(ob[..]), 1)
        f64.o_gemv(Lib.Accelerate, trans, m, n, 1, as_mut_ptr(a[..]), 2, as_mut_ptr(x[..]), 1, 0.5, as_mut_ptr(acc[..]), 1)
        assert(ours == [3.0, 4] && ob == [3.0, 4], "the reference leaves y")
        if trans
            assert(acc == [1.5, 2], "Accelerate scales y when the transpose has no columns")
        else
            assert(acc == [3.0, 4], "Accelerate leaves y when the matrix has no columns")

@test("gemv agrees with Accelerate and OpenBLAS at every shape, stride, transpose and scaling, f32")
oracle_gemv_f32()
    for lib in libs
        check_gemv[f32](lib, 6)

@test("ger agrees with Accelerate and OpenBLAS at every shape and stride, either way round, f64")
oracle_ger_f64()
    for lib in libs
        check_ger[f64](lib, 7)

@test("ger agrees with Accelerate and OpenBLAS at every shape and stride, either way round, f32")
oracle_ger_f32()
    for lib in libs
        check_ger[f32](lib, 8)

@test("dot, nrm2, asum and iamax agree with Accelerate and OpenBLAS, f64")
oracle_reductions_f64()
    for lib in libs
        check_reductions[f64](lib, 1)

@test("dot, nrm2, asum and iamax agree with Accelerate and OpenBLAS, f32")
oracle_reductions_f32()
    for lib in libs
        check_reductions[f32](lib, 2)

@test("axpy, scal, copy, swap and rot agree with Accelerate and OpenBLAS, f64")
oracle_updates_f64()
    for lib in libs
        check_updates[f64](lib, 3)

@test("axpy, scal, copy, swap and rot agree with Accelerate and OpenBLAS, f32")
oracle_updates_f32()
    for lib in libs
        check_updates[f32](lib, 4)

@test("rotg agrees with Accelerate and OpenBLAS on every sign and magnitude order")
oracle_rotg()
    for lib in libs
        check_rotg_cases[f64](lib)
        check_rotg_cases[f32](lib)

@test("iamax breaks ties as Accelerate and OpenBLAS do, at every stride")
oracle_iamax_ties()
    for lib in libs
        check_iamax_ties[f64](lib)
        check_iamax_ties[f32](lib)

@test("the two oracles are two libraries: OpenBLAS is loaded, and answers as Accelerate does")
oracle_both_present()
    assert(ob_distinct() == 1, "OpenBLAS's cblas_ddot is the linked one")
    var xs = [1.0, -2.0, 3.0]
    var ys = [4.0, 5.0, -6.0]
    for lib in libs
        assert(f64.o_dot(lib, 3, as_mut_ptr(xs[..]), 1, as_mut_ptr(ys[..]), 1) == -24.0, lib.name())
