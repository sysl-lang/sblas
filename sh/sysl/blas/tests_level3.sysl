module sh.sysl.blas
@tests

import sysl.buf.{Buf, buf_filled}

// gemm against its definition, computed here element by element, at sizes that cross every blocking
// boundary — one either side of MR, NR, KC, MC and NC — so every fringe of the packing and every
// partial tile of the write-back is reached. Agreement with Accelerate and OpenBLAS on random data,
// every transpose and leading dimension, is in the oracle's tests.

/** A deterministic stream of values in [-1, 1), from a 64-bit xorshift. */
private struct Gen
    state: u64

impl Gen
    next(*self) -> f64
        self.state ^= self.state << 13
        self.state ^= self.state >> 7
        self.state ^= self.state << 17
        f64(self.state >> 11) * 0x1p-52 - 1

/** `num / den` at width T, built from ones, since `Real` has no conversion from f64. Every value the
 * checks use is a small integer or a dyadic fraction, so every product and sum in them is exact and C
 * can be compared for equality, whatever order the kernel adds in.
 */
private ratio[T: Real](num: int, den: int) -> T
    var x = T.zero()
    for _ in 0..<num.abs()
        x = x + T.one()
    var d = T.zero()
    for _ in 0..<den
        d = d + T.one()
    if num < 0 then -x / d else x / d

/** `n` integers in [-4, 3]. */
private filled[T: Real](n: usize, g: *Gen) -> Buf[T]
    val b: Buf[T] = buf_filled(n, T.zero())
    for i in 0..<n
        b[i] = ratio[T](int((g.next() + 1) * 4) - 4, 1)
    b

/** Runs gemm on a column-major problem with leading dimensions one more than the rows, and checks every
 * element of C against the definition, and the padding between columns against what it was.
 */
private check_def[T: Real](m: usize, n: usize, k: usize, alpha: T, beta: T, seed: u64)
    check_def_layout[T](m, n, k, alpha, beta, seed, false, false)

/** `check_def`, with A stored either column-major or as the transpose of a column-major `k` x `m`, and B
 * either column-major or as the transpose of a column-major `n` x `k`.
 */
private check_def_layout[T: Real](m: usize, n: usize, k: usize, alpha: T, beta: T, seed: u64, a_transposed: bool, b_transposed: bool)
    var g = Gen(seed)
    val lda = if a_transposed then k + 1 else m + 1
    val ldb = if b_transposed then n + 1 else k + 1
    val ldc = m + 1
    val a = filled[T](lda * (if a_transposed then m else k), &g)
    val b = filled[T](ldb * (if b_transposed then k else n), &g)
    val c = filled[T](ldc * n, &g)
    val c0: Buf[T] = buf_filled(c.len(), T.zero())
    for i in 0..<c.len()
        c0[i] = c[i]
    val len = gemm_work_len[T](m, n, k)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    val av = if a_transposed then matrix(a.view(), k, m, lda).t() else matrix(a.view(), m, k, lda)
    val bv = if b_transposed then matrix(b.view(), n, k, ldb).t() else matrix(b.view(), k, n, ldb)
    gemm(alpha, av, bv, beta, matrix_mut(c.view(), m, n, ldc), GemmWork(pa.view(), pb.view()))
    for j in 0..<n
        for i in 0..<m
            var s = T.zero()
            for p in 0..<k
                val aip = if a_transposed then a[p + i * lda] else a[i + p * lda]
                val bpj = if b_transposed then b[j + p * ldb] else b[p + j * ldb]
                s = s + aip * bpj
            assert(c[i + j * ldc] == alpha * s + beta * c0[i + j * ldc], "gemm differs from its definition")
        assert(c[m + j * ldc] == c0[m + j * ldc], "gemm wrote between C's columns")

/** One either side of `b`, and `b` itself. */
private around(b: usize) -> [3]usize = [b - 1, b, b + 1]

private sweep[T: Real](seed: u64)
    val (mr, nr, kc, mc, ncols) = gemm_blocking[T]()
    val depths: [3]usize = [1, 2, 7]
    var s = seed
    for m in [1, mr - 1, mr, mr + 1, 2 * mr + 3]
        for n in [1, nr - 1, nr, nr + 1, 2 * nr + 1]
            for k in depths
                check_def[T](m, n, k, ratio[T](3, 2), ratio[T](-1, 2), s)
                s += 1
    for k in around(kc)
        check_def[T](mr + 1, nr + 1, k, ratio[T](3, 4), T.one(), s)
        check_def[T](3, 2, 2 * k, T.one(), T.zero(), s + 1)
        s += 2
    for m in around(mc)
        check_def[T](m, nr + 1, 5, ratio[T](-5, 4), ratio[T](2, 1), s)
        check_def[T](m + mc, 3, kc + 3, T.one(), T.one(), s + 1)
        s += 2
    for n in around(ncols)
        check_def[T](mr + 3, n, 3, ratio[T](1, 2), ratio[T](1, 4), s)
        s += 1

/** The micro-kernel takes two rank-1 updates per trip and the odd one alone; a whole panel of a
 * column-major A is packed by vectors, and a whole panel of B by vectors V rows at a time (column-major)
 * or a row at a time (row-major): every depth either side of those steps, at the first and a later KC
 * slice, with A and B each column-major and transposed, full panels beside a fringe one.
 */
private depths[T: Real](seed: u64)
    val (mr, nr, kc, _, _) = gemm_blocking[T]()
    var s = seed
    for k in [1, 2, 3, 4, 5, 6, 7, 8, 9, kc - 1, kc + 1, kc + 2, kc + 3, kc + 5, 2 * kc - 1]
        for a_transposed in [false, true]
            for b_transposed in [false, true]
                check_def_layout[T](2 * mr + 1, 2 * nr + 1, k, ratio[T](3, 2), ratio[T](-1, 2), s, a_transposed, b_transposed)
                check_def_layout[T](mr, nr, k, ratio[T](-3, 4), T.zero(), s + 1, a_transposed, b_transposed)
                s += 2

@test("gemm's micro-kernel and packing are right at every depth around their steps, f64")
gemm_depths_f64()
    depths[f64](21)

@test("gemm's micro-kernel and packing are right at every depth around their steps, f32")
gemm_depths_f32()
    depths[f32](22)

/** Packs a `k` x `n` B stored column-major (`transposed` false) or as the transpose of a column-major
 * `n` x `k`, with leading dimension one past the minimum, from row `p0` and column `j0`, and checks
 * every element of every panel against the matrix, a fringe panel's padding against zero, and the
 * buffer past the panels against the NaN it was seeded with.
 */
private check_pack_b[T: Real, const V: usize, const NR: usize](k: usize, n: usize, p0: usize, j0: usize, transposed: bool, seed: u64)
    var g = Gen(seed)
    val ld = if transposed then n + 1 else k + 1
    val b = filled[T](ld * (if transposed then k else n), &g)
    val bm = if transposed then matrix(b.view(), n, k, ld).t() else matrix(b.view(), k, n, ld)
    val kc = k - p0
    val nc = n - j0
    val panels = (nc + NR - 1) / NR
    val nan = T.zero() / T.zero()
    val out: Buf[T] = buf_filled(panels * NR * kc + 3, nan)
    pack_b[T, V, NR](bm, p0, kc, j0, nc, out.view())
    for r in 0..<panels
        for p in 0..<kc
            for j in 0..<NR
                val got = out[r * NR * kc + p * NR + j]
                val col = r * NR + j
                if col < nc
                    assert(got == bm.at(p0 + p, j0 + col), "B's packing differs from the matrix")
                else
                    assert(got == T.zero(), "B's packing left a fringe column unpadded")
    for i in panels * NR * kc..<out.len()
        assert(out[i] != out[i], "B's packing wrote past its panels")

/** B's packing at both layouts, at depths either side of whole V-row steps and widths either side of
 * whole panels, from the matrix's corner and from inside it.
 */
private pack_b_shapes[T: Real, const V: usize](seed: u64)
    val widths: [6]usize = [1, 5, 6, 7, 12, 13]
    var s = seed
    for k in [1, V - 1, V, V + 1, 2 * V + 1, 3 * V]
        for n in widths
            for transposed in [false, true]
                check_pack_b[T, V, 6](k, n, 0, 0, transposed, s)
                check_pack_b[T, V, 6](k + 3, n + 2, 3, 2, transposed, s + 1)
                check_pack_b[T, V, 4](k, n, 0, 0, transposed, s + 2)
                check_pack_b[T, V, V](k + 1, n + 1, 1, 1, transposed, s + 3)
                s += 4

@test("gemm's B packing matches the matrix at both layouts and every fringe, f64")
gemm_pack_b_f64()
    pack_b_shapes[f64, 2](41)

@test("gemm's B packing matches the matrix at both layouts and every fringe, f32")
gemm_pack_b_f32()
    pack_b_shapes[f32, 4](42)

/** Turns the V x V block whose column `j` holds `j * V + l` in lane `l`, and checks each row. */
private check_transpose[T: Real, const V: usize]()
    var cols: [V]<V>T
    for const j in 0..<V
        for const l in 0..<V
            cols[j][l] = ratio[T](int(j * V + l), 1)
    val rows = transpose[T, V](cols)
    for const l in 0..<V
        for const j in 0..<V
            assert(rows[l][j] == ratio[T](int(j * V + l), 1), "the transpose put a lane in the wrong place")

@test("the in-register transpose turns columns into rows at every width gemm packs with")
gemm_transpose()
    check_transpose[f64, 2]()
    check_transpose[f32, 4]()
    check_transpose[f32, 2]()
    check_transpose[f64, 4]()
    check_transpose[f32, 8]()

/** The micro-kernel alone at one tile, against the definition: panels exactly `kc` steps long, so the
 * last step's vector loads of B end at the panel's last element, and a tile seeded with NaN, which
 * every element must overwrite.
 */
private check_micro[T: Real, const V: usize, const MV: usize, const NR: usize](kc: usize, seed: u64)
    var g = Gen(seed)
    val mr = V * MV
    val ap = filled[T](kc * mr, &g)
    val bp = filled[T](kc * NR, &g)
    val tile: Buf[T] = buf_filled(mr * NR, T.zero() / T.zero())
    micro[T, V, MV, NR](kc, ap.view(), bp.view(), tile.view())
    for j in 0..<NR
        for i in 0..<mr
            var s = T.zero()
            for p in 0..<kc
                s = s + ap[p * mr + i] * bp[p * NR + j]
            assert(tile[j * mr + i] == s, "the micro-kernel differs from its definition")

/** Every tile shape a target uses — AArch64's f64 8x6 and f32 16x6 (NR not a multiple of V, so the last
 * vector of B's row overlaps the one before it) and the fallback's f64 4x4 and f32 8x4 — plus an NR
 * one short of and one past a multiple of V, one of exactly V, and one of nine (two or more whole
 * vectors at both widths), at depths either side of one and two trips of the unrolled loop.
 */
private micro_shapes[T: Real, const V: usize](seed: u64)
    val depths: [9]usize = [1, 2, 3, 4, 5, 7, 8, 9, 13]
    var s = seed
    for kc in depths
        check_micro[T, V, 4, 6](kc, s)
        check_micro[T, V, 2, 4](kc, s + 1)
        check_micro[T, V, 1, 5](kc, s + 2)
        check_micro[T, V, 2, 7](kc, s + 3)
        check_micro[T, V, 1, V](kc, s + 4)
        check_micro[T, V, 1, 9](kc, s + 5)
        s += 6

@test("gemm's micro-kernel is right at every tile shape a target uses, f64")
gemm_micro_f64()
    micro_shapes[f64, 2](31)

@test("gemm's micro-kernel is right at every tile shape a target uses, f32")
gemm_micro_f32()
    micro_shapes[f32, 4](32)

@test("gemm agrees with its definition across every blocking boundary, f64")
gemm_sizes_f64()
    sweep[f64](11)

@test("gemm agrees with its definition across every blocking boundary, f32")
gemm_sizes_f32()
    sweep[f32](12)

@test("gemm's blocking is a whole number of tiles, at both widths")
gemm_blocking_tiles()
    for (mr, nr, kc, mc, ncols) in [gemm_blocking[f64](), gemm_blocking[f32]()]
        assert(mc % mr == 0 && ncols % nr == 0 && kc > 0)
    val (mr64, _, kc64, mc64, _) = gemm_blocking[f64]()
    val (mr32, _, kc32, mc32, _) = gemm_blocking[f32]()
    assert(mr32 == 2 * mr64 && kc32 == 2 * kc64 && mc32 == 2 * mc64, "f32 panels hold the bytes f64's do")

@test("gemm with beta zero does not read C: a NaN there is overwritten")
gemm_beta_zero_nan()
    val shapes: [3](usize, usize, usize) = [(3, 2, 4), (9, 7, 1), (17, 13, 3)]
    for (m, n, k) in shapes
        val c: Buf[f64] = buf_filled(m * n, f64.nan())
        val a: Buf[f64] = buf_filled(m * k, 1.0)
        val b: Buf[f64] = buf_filled(k * n, 2.0)
        gemm_into(1.0, a, b, 0.0, c, m, n, k)
        for i in 0..<m * n
            assert(c[i] == f64(2 * k))

@test("gemm with alpha zero reads neither A nor B, and scales C by beta")
gemm_alpha_zero()
    val c: Buf[f64] = buf_filled(6, 3.0)
    val a: Buf[f64] = buf_filled(6, f64.nan())
    val b: Buf[f64] = buf_filled(4, f64.nan())
    gemm_into(0.0, a, b, 0.5, c, 3, 2, 2)
    for i in 0..<6
        assert(c[i] == 1.5)
    gemm_into(0.0, a, b, 0.0, c, 3, 2, 2)
    for i in 0..<6
        assert(c[i] == 0.0)
    c[0] = f64.nan()
    gemm_into(0.0, a, b, 0.0, c, 3, 2, 2)
    assert(c[0] == 0.0, "beta zero clears a NaN even when alpha is zero")

@test("gemm with alpha zero and beta one leaves a NaN in C alone")
gemm_alpha_zero_beta_one()
    val c: Buf[f64] = buf_filled(6, f64.nan())
    val a: Buf[f64] = buf_filled(6, 1.0)
    val b: Buf[f64] = buf_filled(4, 1.0)
    gemm_into(0.0, a, b, 1.0, c, 3, 2, 2)
    assert(c[0].is_nan() && c[5].is_nan())

@test("gemm with an empty shared dimension scales C by beta and reads no packing buffer")
gemm_empty_k()
    val c: Buf[f64] = buf_filled(6, 4.0)
    val none: Buf[f64] = buf_filled(0, 0.0)
    gemm(2.0, matrix(none.view(), 3, 0, 3), matrix(none.view(), 0, 2, 1), 0.25, matrix_mut(c.view(), 3, 2, 3), GemmWork(none.view(), none.view()))
    for i in 0..<6
        assert(c[i] == 1.0)
    val len = gemm_work_len[f64](3, 2, 0)
    assert(len.a == 0 && len.b == 0)

@test("gemm with an empty m or n does nothing, whatever the other dimensions")
gemm_empty_mn()
    val none: Buf[f64] = buf_filled(0, 0.0)
    val a: Buf[f64] = buf_filled(12, f64.nan())
    gemm(1.0, matrix(none.view(), 0, 4, 1), matrix(a.view(), 4, 3, 4), 0.0, matrix_mut(none.view(), 0, 3, 1), GemmWork(none.view(), none.view()))
    gemm(1.0, matrix(a.view(), 3, 4, 3), matrix(none.view(), 4, 0, 4), 0.0, matrix_mut(none.view(), 3, 0, 3), GemmWork(none.view(), none.view()))
    assert(gemm_work_len[f32](0, 5, 5).a == 0 && gemm_work_len[f32](5, 0, 5).b == 0)

@test("a transpose is the same storage with the strides swapped")
gemm_transposes()
    // A = [[1, 2, 3], [4, 5, 6]] (2 x 3), stored column-major; At = its 3 x 2 transpose, stored column-major.
    val a: [6]f64 = [1, 4, 2, 5, 3, 6]
    val at: [6]f64 = [1, 2, 3, 4, 5, 6]
    var c1: [4]f64
    var c2: [4]f64
    var c3: [4]f64
    var c4: [4]f64
    var pa: [64]f64
    var pb: [64]f64
    val w = GemmWork(pa[..], pb[..])
    // A * A^T four ways: [[14, 32], [32, 77]].
    gemm(1.0, matrix(a[..], 2, 3, 2), matrix(a[..], 2, 3, 2).t(), 0.0, matrix_mut(c1[..], 2, 2, 2), w)
    gemm(1.0, matrix(at[..], 3, 2, 3).t(), matrix(at[..], 3, 2, 3), 0.0, matrix_mut(c2[..], 2, 2, 2), w)
    gemm(1.0, matrix(a[..], 2, 3, 2), matrix(at[..], 3, 2, 3), 0.0, matrix_mut(c3[..], 2, 2, 2), w)
    gemm(1.0, matrix(at[..], 3, 2, 3).t(), matrix(a[..], 2, 3, 2).t(), 0.0, matrix_mut(c4[..], 2, 2, 2), w)
    val want: [4]f64 = [14, 32, 32, 77]
    assert(c1 == want && c2 == want && c3 == want && c4 == want)
    // A row-major C is the transpose of a column-major one.
    var cr: [4]f64
    gemm(1.0, matrix(a[..], 2, 3, 2), matrix(at[..], 3, 2, 3), 0.0, matrix_mut(cr[..], 2, 2, 2).t(), w)
    assert(cr == want)
    // A^T * A is 3 x 3 and symmetric, so row-major and column-major C agree.
    var c6: [9]f64
    gemm(1.0, matrix(at[..], 3, 2, 3), matrix(a[..], 2, 3, 2), 0.0, matrix_mut(c6[..], 3, 3, 3).t(), w)
    val want6: [9]f64 = [17, 22, 27, 22, 29, 36, 27, 36, 45]
    assert(c6 == want6)

@test("gemm traps on matrices whose shapes disagree", should_trap)
gemm_shape_mismatch()
    var c: [4]f64
    var w: [64]f64
    val a: [6]f64 = [1, 2, 3, 4, 5, 6]
    gemm(1.0, matrix(a[..], 2, 3, 2), matrix(a[..], 2, 3, 2), 0.0, matrix_mut(c[..], 2, 2, 2), GemmWork(w[..], w[..]))

@test("gemm traps on packing buffers shorter than gemm_work_len says", should_trap)
gemm_short_work()
    var c: [4]f64
    var pa: [3]f64
    var pb: [64]f64
    val a: [6]f64 = [1, 2, 3, 4, 5, 6]
    gemm(1.0, matrix(a[..], 2, 3, 2), matrix(a[..], 3, 2, 3), 0.0, matrix_mut(c[..], 2, 2, 2), GemmWork(pa[..], pb[..]))

@test("a hand-built matrix view past its data traps before gemm reads it", should_trap)
gemm_hand_built_past_end()
    var c: [4]f64
    var w: [64]f64
    val a: [6]f64 = [1, 2, 3, 4, 5, 6]
    gemm(1.0, Matrix(a[..], 2, 4, 1, 2), matrix(a[..], 4, 2, 4), 0.0, matrix_mut(c[..], 2, 2, 2), GemmWork(w[..], w[..]))

@test("a hand-built C past its data traps before gemm writes it, even with alpha zero", should_trap)
gemm_hand_built_c_past_end()
    var c: [4]f64
    var w: [64]f64
    val a: [6]f64 = [1, 2, 3, 4, 5, 6]
    gemm(0.0, matrix(a[..], 2, 3, 2), matrix(a[..], 3, 2, 3), 0.0, MatrixMut(c[..], 2, 3, 1, 2), GemmWork(w[..], w[..]))

/** gemm over contiguous column-major buffers, with buffers sized by gemm_work_len. */
private gemm_into(alpha: f64, a: Buf[f64], b: Buf[f64], beta: f64, c: Buf[f64], m: usize, n: usize, k: usize)
    val len = gemm_work_len[f64](m, n, k)
    val pa: Buf[f64] = buf_filled(len.a, 0.0)
    val pb: Buf[f64] = buf_filled(len.b, 0.0)
    gemm(alpha, matrix(a.view(), m, k, m), matrix(b.view(), k, n, k), beta, matrix_mut(c.view(), m, n, m), GemmWork(pa.view(), pb.view()))
