module sh.sysl.sblas.heap

import sh.sysl.sblas.{Real, Matrix, MatrixMut, GemmWork, Side, Uplo, Diag, gemm, gemm_work_len, trsm, trsm_work_len}
import sysl.buf.{Buf, buf_filled}

// The routines of sh.sysl.sblas that need scratch storage, in the form that allocates it per call.
// sh.sysl.sblas itself is `@no_alloc`, so it runs on a board with no heap; this module is the
// convenience for a program that has one.

/** `c := alpha * a * b + beta * c`, as `sh.sysl.sblas.gemm`, with packing buffers allocated for the
 * call and freed after it.
 */
gemm_alloc[T: Real](alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T])
    val len = gemm_work_len[T](c.rows, c.cols, a.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    gemm(alpha, a, b, beta, c, GemmWork(pa.view(), pb.view()))

/** The triangular solve of `sh.sysl.sblas.trsm`, with packing buffers allocated for the call and freed
 * after it.
 */
trsm_alloc[T: Real](side: Side, uplo: Uplo, diag: Diag, alpha: T, a: Matrix[T], b: MatrixMut[T])
    val len = trsm_work_len[T](side, b.rows, b.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    trsm(side, uplo, diag, alpha, a, b, GemmWork(pa.view(), pb.view()))
