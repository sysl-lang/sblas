module sh.sysl.sblas.heap

import sh.sysl.sblas.{Real, Matrix, MatrixMut, GemmWork, Side, Uplo, Diag, Workers, gemm, gemm_work_len, gemm_par, gemm_par_work_len, trsm, trsm_work_len, trmm, trmm_work_len, syrk, syrk_work_len}
import sysl.buf.{Buf, buf_filled}

// The routines of sh.sysl.sblas that need scratch storage, in the form that allocates it per call.
// sh.sysl.sblas itself is `@no_alloc`, so it runs on a board with no heap; this module is the
// convenience for a program that has one.

/** `c := alpha * a * b + beta * c`, as `sh.sysl.sblas.gemm`, with packing buffers allocated for the
 * call and freed after it.
 */
gemm_alloc[T: Real](alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T])
    val len = gemm_work_len[T](c.rows, c.cols, a.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    gemm(alpha, a, b, beta, c, GemmWork(pa.view(), pb.view()))

/** `c := alpha * a * b + beta * c` on the caller's `workers`, as `sh.sysl.sblas.gemm_par`, with packing
 * buffers allocated for the call and freed after it.
 */
gemm_par_alloc[T: Real, W: Workers](workers: *W, alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T])
    val len = gemm_par_work_len[T](c.rows, c.cols, a.cols, workers.count())
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    gemm_par(workers, alpha, a, b, beta, c, GemmWork(pa.view(), pb.view()))

/** The triangular solve of `sh.sysl.sblas.trsm`, with packing buffers allocated for the call and freed
 * after it.
 */
trsm_alloc[T: Real](side: Side, uplo: Uplo, diag: Diag, alpha: T, a: Matrix[T], b: MatrixMut[T])
    val len = trsm_work_len[T](side, b.rows, b.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    trsm(side, uplo, diag, alpha, a, b, GemmWork(pa.view(), pb.view()))

/** The triangular multiply of `sh.sysl.sblas.trmm`, with packing buffers allocated for the call and
 * freed after it.
 */
trmm_alloc[T: Real](side: Side, uplo: Uplo, diag: Diag, alpha: T, a: Matrix[T], b: MatrixMut[T])
    val len = trmm_work_len[T](side, b.rows, b.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    trmm(side, uplo, diag, alpha, a, b, GemmWork(pa.view(), pb.view()))

/** The symmetric rank-k update of `sh.sysl.sblas.syrk`, with packing buffers allocated for the call
 * and freed after it.
 */
syrk_alloc[T: Real](uplo: Uplo, alpha: T, a: Matrix[T], beta: T, c: MatrixMut[T])
    val len = syrk_work_len[T](c.rows, a.cols)
    val pa: Buf[T] = buf_filled(len.a, T.zero())
    val pb: Buf[T] = buf_filled(len.b, T.zero())
    syrk(uplo, alpha, a, beta, c, GemmWork(pa.view(), pb.view()))
