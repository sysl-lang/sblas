module sh.sysl.sblas
@no_alloc

import sysl.math.{min, max}
import sysl.vectors.{zip_lo, zip_hi}
// Level 3: gemm, laid out as BLIS lays it out, and trsm on top of it (at the end of the file).
//
// Five loops partition the work. The outermost walks C in column blocks NC wide; inside it the shared
// dimension is cut into slices KC deep, and each KC x NC block of op(B) is packed into panels NR
// columns wide; inside that, op(A) is cut into blocks MC tall, each packed into panels MR rows tall.
// The two innermost loops walk the packed panels a tile at a time and hand each pair to the
// micro-kernel, which keeps an MR x NR block of C in registers and does KC rank-1 updates on it.
//
// Packing is where strides, transposes and fringes are resolved: a panel is contiguous, in exactly the
// order the micro-kernel reads it, and a fringe panel is padded with zeros to a full tile. So the
// micro-kernel only ever sees unit-stride panels and a whole tile; its result goes to a small scratch
// tile, and the write-back adds the part of the tile that lies inside C.
//
// Everything below the routine is generic over the element type and the tile; the routine names the
// tile per target. The packing buffers are the caller's (`GemmWork`), so nothing here allocates;
// `sh.sysl.sblas.heap.gemm_alloc` is the form that makes them.

/** Bytes in one vector register: a NEON or SSE `q` register. */
private const vector_bytes: usize = 16

// The tile, per target. MR is `tile_vectors` vectors of A's column, NR is `tile_cols` lanes of B's
// row (at least one vector's worth), and the accumulators take `tile_vectors * tile_cols` registers.
// KC and MC are in bytes so that both widths keep the same panel footprint: an f32 panel is twice as
// deep and twice as tall.
#if aarch64
// 32 vector registers: 24 accumulators, 4 for A's column, the rest for B's row. f64 8x6 and
// f32 16x6 — the shape of BLIS's armv8a kernels (dgemm 6x8, accumulating along C's rows) turned to
// accumulate along C's columns, which are contiguous here.
private const tile_vectors: usize = 4
private const tile_cols: usize = 6
#else
// 16 vector registers: 8 accumulators.
private const tile_vectors: usize = 2
private const tile_cols: usize = 4
#endif

/** KC: the depth of a packed slice. 256 f64 or 512 f32, so an NR-wide panel of B (12 KB f64) sits in
 * L1 beside the A panel being streamed.
 */
private const kc_bytes: usize = 2048

/** MC: the height of a packed block of A, 120 f64 or 240 f32 — a multiple of MR at both widths. With
 * KC it makes a 240 KB block of A, resident in L2.
 */
private const mc_bytes: usize = 960

/** NC: the width of a packed block of B, in elements (a multiple of NR on every target). */
private const nc: usize = 3072

/** The packing buffers gemm works in: `a` holds one packed block of op(A), `b` one of op(B). Their
 * sizes for a given problem are `gemm_work_len`'s answer, and anything longer is fine.
 */
struct GemmWork[T]
    a: []T
    b: []T

/** How many elements each of `GemmWork`'s two buffers needs for an `m` x `n` result with shared
 * dimension `k`. A zero is a buffer gemm does not touch.
 */
struct GemmWorkLen
    a: usize
    b: usize

private round_up(x: usize, to: usize) -> usize = (x + to - 1) / to * to

private work_len[T, const MR: usize, const NR: usize, const KC: usize, const MC: usize, const NC: usize](m: usize, n: usize, k: usize) -> GemmWorkLen
    if m == 0 || n == 0 || k == 0 then return GemmWorkLen(0, 0)
    val kc = min(k, KC)
    GemmWorkLen(round_up(min(m, MC), MR) * kc, kc * round_up(min(n, NC), NR))

/** The blocking gemm uses at this width on this target, as (MR, NR, KC, MC, NC): what a test must
 * cross to reach every fringe.
 */
private[sblas] gemm_blocking[T: Real]() -> (usize, usize, usize, usize, usize) = (vector_bytes / sizeof(T) * tile_vectors, tile_cols, kc_bytes / sizeof(T), mc_bytes / sizeof(T), nc)

/** The buffer sizes gemm needs for `c` (`m` x `n`) := `alpha * a * b + beta * c`, `a` being `m` x `k`. */
gemm_work_len[T: Real](m: usize, n: usize, k: usize) -> GemmWorkLen
    work_len[T, vector_bytes / sizeof(T) * tile_vectors, tile_cols, kc_bytes / sizeof(T), mc_bytes / sizeof(T), nc](m, n, k)

// --- Packing ---------------------------------------------------------------------------------------

/** Packs rows `i0 ..< i0 + mc` and columns `p0 ..< p0 + kc` of `a` into MR-row panels: panel `r`
 * starts at `r * MR * kc`, and holds column `p` of its rows at `p * MR`. A fringe panel's missing
 * rows are zeros. A whole panel of a column-major `a` is copied a vector of `V` lanes at a time.
 */
private pack_a[T: Real, const V: usize, const MR: usize](a: Matrix[T], i0: usize, mc: usize, p0: usize, kc: usize, out: []T)
    assert(round_up(mc, MR) * kc <= out.len, "gemm's A packing buffer is too short for the block")
    val rs = a.row_stride
    val cs = a.col_stride
    var at: usize = 0
    var ir: usize = 0
    @unchecked
        while ir < mc
            val mr = min(mc - ir, MR)
            val base = (i0 + ir) * rs + p0 * cs
            if mr == MR && rs == 1
                for p in 0..<kc
                    val col = base + p * cs
                    for const v in 0..<MR / V
                        val x: <V>T = a.data.load(col + v * V)
                        out.store(at + v * V, x)
                    at += MR
            else
                for p in 0..<kc
                    val col = base + p * cs
                    for i in 0..<mr
                        out[at + i] = a.data[col + i * rs]
                    for i in mr..<MR
                        out[at + i] = T.zero()
                    at += MR
            ir += MR

/** Packs rows `p0 ..< p0 + kc` and columns `j0 ..< j0 + nc` of `b` into NR-column panels: panel `r`
 * starts at `r * NR * kc`, and holds row `p` of its columns at `p * NR`. A fringe panel's missing
 * columns are zeros.
 *
 * A whole panel is moved `V` lanes at a time where `b` allows it. A row-major `b` holds each row's NR
 * elements side by side, so a row is copied as vectors. A column-major `b` holds V rows of each
 * column side by side: the NR columns are loaded as vectors, turned into V rows in registers
 * (`transpose`), and stored a row at a time. Where NR is not a multiple of V the last V columns are
 * turned and stored over the row's end, rewriting the columns they share with the group before them
 * with the same values, as the micro-kernel reads them. What is left — a fringe panel, rows past the
 * last whole V, any other strides — is copied an element at a time.
 */
private pack_b[T: Real, const V: usize, const NR: usize](b: Matrix[T], p0: usize, kc: usize, j0: usize, nc: usize, out: []T)
    assert(round_up(nc, NR) * kc <= out.len, "gemm's B packing buffer is too short for the block")
    val rs = b.row_stride
    val cs = b.col_stride
    var at: usize = 0
    var jr: usize = 0
    @unchecked
        while jr < nc
            val nr = min(nc - jr, NR)
            val base = p0 * rs + (j0 + jr) * cs
            var p: usize = 0
            if nr == NR && cs == 1
                while p < kc
                    val row = base + p * rs
                    for const jv in 0..<NR / V
                        val x: <V>T = b.data.load(row + jv * V)
                        out.store(at + jv * V, x)
                    if const NR % V != 0
                        val x: <V>T = b.data.load(row + NR - V)
                        out.store(at + NR - V, x)
                    at += NR
                    p += 1
            else if nr == NR && rs == 1
                while p + V <= kc
                    val col = base + p
                    for const g in 0..<NR / V
                        var cols: [V]<V>T
                        for const l in 0..<V
                            cols[l] = b.data.load(col + (g * V + l) * cs)
                        val rows = transpose[T, V](cols)
                        for const l in 0..<V
                            out.store(at + l * NR + g * V, rows[l])
                    if const NR % V != 0
                        var cols: [V]<V>T
                        for const l in 0..<V
                            cols[l] = b.data.load(col + (NR - V + l) * cs)
                        val rows = transpose[T, V](cols)
                        for const l in 0..<V
                            out.store(at + l * NR + NR - V, rows[l])
                    at += V * NR
                    p += V
            while p < kc
                val row = base + p * rs
                for j in 0..<nr
                    out[at + j] = b.data[row + j * cs]
                for j in nr..<NR
                    out[at + j] = T.zero()
                at += NR
                p += 1
            jr += NR

/** The V x V block whose columns are `cols`, as its rows: lane `j` of row `l` is lane `l` of column
 * `j`. Each of log₂ V rounds interleaves vector `i` with vector `i + V/2` (`zip1` and `zip2` on
 * AArch64), and after the last round the rows are in order. V is a power of two.
 */
private transpose[T: Real, const V: usize](cols: [V]<V>T) -> [V]<V>T
    var m = cols
    for const s in 0..<V
        if const (usize(1) << s) < V
            val n = m
            for const i in 0..<V / 2
                m[2 * i] = n[i].shuffle(n[i + V / 2], zip_lo[V]())
                m[2 * i + 1] = n[i].shuffle(n[i + V / 2], zip_hi[V]())
    m

// --- The micro-kernel ------------------------------------------------------------------------------

/** How many rank-1 updates the micro-kernel's loop does per trip; the rest of `kc` runs one at a time.
 * Two takes the loop's own count, add and branch off every other step (10% faster on an M5). Four no
 * longer spills (28.5 instructions a step against two's 29.5), but measures no faster.
 */
private const k_unroll: usize = 2

/** `tile := A~ * B~` for one MR x NR tile, MR being `MV` vectors of `V` lanes: `kc` rank-1 updates, each
 * a column of the A panel (`MV` loads) times the B panel's row. The row is read as whole vectors, and
 * each of its NR elements feeds `MV` fused multiply-adds as a lane of one, so no element is loaded on
 * its own. Where NR is not a multiple of V, the last vector is the row's last V elements (NR is at
 * least V on every target), of which only the lanes past the whole vectors are used. Every index is a
 * `for const`, so each lane, column and accumulator is fixed at compile time. The tile is written
 * column-major, MR elements to a column.
 */
private[sblas] micro[T: Real, const V: usize, const MV: usize, const NR: usize](kc: usize, ap: []const T, bp: []const T, tile: []T)
    var acc: [NR][MV]<V>T
    var a: [MV]<V>T
    @unchecked
        for q in 0..<kc / k_unroll
            for const u in 0..<k_unroll
                val p = q * k_unroll + u
                val ao = p * V * MV
                for const v in 0..<MV
                    a[v] = ap.load(ao + v * V)
                val bo = p * NR
                for const jv in 0..<NR / V
                    val b: <V>T = bp.load(bo + jv * V)
                    for const l in 0..<V
                        for const v in 0..<MV
                            acc[jv * V + l][v] = a[v].mul_add(b[l], acc[jv * V + l][v])
                if const NR % V != 0
                    val b: <V>T = bp.load(bo + NR - V)
                    for const l in V - NR % V..<V
                        for const v in 0..<MV
                            acc[NR - V + l][v] = a[v].mul_add(b[l], acc[NR - V + l][v])
        for p in kc / k_unroll * k_unroll..<kc
            val ao = p * V * MV
            for const v in 0..<MV
                a[v] = ap.load(ao + v * V)
            val bo = p * NR
            for const jv in 0..<NR / V
                val b: <V>T = bp.load(bo + jv * V)
                for const l in 0..<V
                    for const v in 0..<MV
                        acc[jv * V + l][v] = a[v].mul_add(b[l], acc[jv * V + l][v])
            if const NR % V != 0
                val b: <V>T = bp.load(bo + NR - V)
                for const l in V - NR % V..<V
                    for const v in 0..<MV
                        acc[NR - V + l][v] = a[v].mul_add(b[l], acc[NR - V + l][v])
        for const j in 0..<NR
            for const v in 0..<MV
                tile.store((j * MV + v) * V, acc[j][v])

/** Adds the `mr` x `nr` corner of `tile` into C at (`i0`, `j0`): `c := alpha * tile + beta * c`, where
 * a `beta` of zero writes without reading C, so a NaN there does not survive. A whole column of the
 * tile into a column-major C moves as `MR / V` vectors; anything else an element at a time.
 */
private write_back[T: Real, const V: usize, const MR: usize](c: MatrixMut[T], i0: usize, j0: usize, mr: usize, nr: usize, tile: []const T, alpha: T, beta: T)
    val rs = c.row_stride
    val cs = c.col_stride
    @unchecked
        if mr == MR && rs == 1
            for j in 0..<nr
                val col = i0 + (j0 + j) * cs
                for const v in 0..<MR / V
                    val t: <V>T = tile.load(j * MR + v * V)
                    if beta == T.zero()
                        c.data.store(col + v * V, t * alpha)
                    else
                        val old: <V>T = c.data.load(col + v * V)
                        c.data.store(col + v * V, t * alpha + old * beta)
            return
        for j in 0..<nr
            val col = i0 * rs + (j0 + j) * cs
            if beta == T.zero()
                for i in 0..<mr
                    c.data[col + i * rs] = alpha * tile[j * MR + i]
            else
                for i in 0..<mr
                    val at = col + i * rs
                    c.data[at] = alpha * tile[j * MR + i] + beta * c.data[at]

/** `write_back` for a tile that the diagonal of a triangular C crosses: only the elements of the `lower`
 * (or upper) triangle are written, and only they are read when `beta` is not zero.
 */
private write_back_tri[T: Real, const MR: usize](lower: bool, c: MatrixMut[T], i0: usize, j0: usize, mr: usize, nr: usize, tile: []const T, alpha: T, beta: T)
    val rs = c.row_stride
    val cs = c.col_stride
    @unchecked
        for j in 0..<nr
            val d = j0 + j
            // Rows i0 + i of column d inside the triangle: i0 + i >= d for lower, <= d for upper.
            val (lo, hi) = if lower then (if d > i0 then min(d - i0, mr) else 0, mr) else (0, if d >= i0 then min(d - i0 + 1, mr) else 0)
            val col = i0 * rs + d * cs
            for i in lo..<hi
                val at = col + i * rs
                c.data[at] = if beta == T.zero() then alpha * tile[j * MR + i] else alpha * tile[j * MR + i] + beta * c.data[at]

/** The triangle of C the five loops write: all of it for gemm, or syrk's lower or upper one. */
private const tri_all: usize = 0
private const tri_lower: usize = 1
private const tri_upper: usize = 2

/** Where the `rows` x `cols` block of C at (`i0`, `j0`) lies against triangle `tri`: 0 outside it, 1
 * across its diagonal, 2 inside it. Everything is inside `tri_all`.
 */
private tri_part(tri: usize, i0: usize, rows: usize, j0: usize, cols: usize) -> usize
    if tri == tri_all then return 2
    if tri == tri_lower
        if i0 + rows <= j0 then return 0
        if i0 + 1 >= j0 + cols then return 2
        return 1
    if i0 >= j0 + cols then return 0
    if i0 + rows <= j0 + 1 then return 2
    1

/** `c := beta * c` on the `lower` (or upper) triangle only, reading nothing when `beta` is zero and
 * touching nothing when it is one.
 */
private scale_tri[T: Real](lower: bool, c: MatrixMut[T], beta: T)
    if beta == T.one() then return
    @unchecked
        for j in 0..<c.cols
            val (lo, hi) = if lower then (j, c.rows) else (0, j + 1)
            for i in lo..<hi
                val at = i * c.row_stride + j * c.col_stride
                c.data[at] = if beta == T.zero() then T.zero() else beta * c.data[at]

/** `c := beta * c`, reading nothing when `beta` is zero and touching nothing when it is one. */
private scale_c[T: Real](c: MatrixMut[T], beta: T)
    if beta == T.one() then return
    @unchecked
        for j in 0..<c.cols
            for i in 0..<c.rows
                val at = i * c.row_stride + j * c.col_stride
                c.data[at] = if beta == T.zero() then T.zero() else beta * c.data[at]

// --- The five loops --------------------------------------------------------------------------------

/** The five loops at one tile: MR = `V * MV`, and `TILE` = MR * NR is passed on its own, since an
 * array's length may name a value parameter but not compute with one.
 *
 * `TRI` names the triangle of C written: `tri_all` for gemm, or syrk's. A block of A or a tile wholly
 * outside the triangle is neither packed nor multiplied, and a tile the diagonal crosses is written
 * back only inside it; elsewhere the loops are gemm's, and `TRI` being a constant folds the checks.
 */
private gemm_blocked[T: Real, const V: usize, const MV: usize, const NR: usize, const TILE: usize, const KC: usize, const MC: usize, const NC: usize, const TRI: usize](alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T], work: GemmWork[T])
    val m = c.rows
    val n = c.cols
    val k = a.cols
    val need = work_len[T, V * MV, NR, KC, MC, NC](m, n, k)
    assert(work.a.len >= need.a && work.b.len >= need.b, "gemm's packing buffers are shorter than gemm_work_len says")
    var tile: [TILE]T
    var jc: usize = 0
    while jc < n
        val ncb = min(n - jc, NC)
        var pc: usize = 0
        while pc < k
            val kc = min(k - pc, KC)
            val beta_here = if pc == 0 then beta else T.one()
            pack_b[T, V, NR](b, pc, kc, jc, ncb, work.b)
            var ic: usize = 0
            while ic < m
                val mcb = min(m - ic, MC)
                if tri_part(TRI, ic, mcb, jc, ncb) != 0
                    pack_a[T, V, V * MV](a, ic, mcb, pc, kc, work.a)
                    var jr: usize = 0
                    while jr < ncb
                        val bp = work.b[jr * kc..<(jr + NR) * kc]
                        val nr = min(ncb - jr, NR)
                        var ir: usize = 0
                        while ir < mcb
                            val mr = min(mcb - ir, V * MV)
                            val part = tri_part(TRI, ic + ir, mr, jc + jr, nr)
                            if part != 0
                                micro[T, V, MV, NR](kc, work.a[ir * kc..<(ir + V * MV) * kc], bp, tile[..])
                                if part == 2
                                    write_back[T, V, V * MV](c, ic + ir, jc + jr, mr, nr, tile[..], alpha, beta_here)
                                else
                                    write_back_tri[T, V * MV](TRI == tri_lower, c, ic + ir, jc + jr, mr, nr, tile[..], alpha, beta_here)
                            ir += V * MV
                        jr += NR
                ic += MC
            pc += KC
        jc += NC

// --- The routine -----------------------------------------------------------------------------------

/** `c := alpha * a * b + beta * c`, packing into the caller's `work` (`gemm_work_len` says how much).
 *
 * `a` is `m` x `k`, `b` is `k` x `n` and `c` is `m` x `n`; a transpose is passed as `a.t()`. As in the
 * reference BLAS, a `beta` of zero sets C without reading it, so a NaN or an infinity there does not
 * survive, and an `alpha` of zero or an empty `k` reads neither `a` nor `b`. Dimensions that disagree
 * trap, and so does a view built by hand that reaches past its data.
 */
gemm[T: Real](alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T], work: GemmWork[T])
    assert(a.rows == c.rows && b.cols == c.cols && a.cols == b.rows, "gemm's matrices do not agree in shape")
    assert(holds(c.data.len, c.rows, c.cols, c.row_stride, c.col_stride), "a matrix reaches past the end of its data")
    if c.rows == 0 || c.cols == 0 then return
    if alpha == T.zero() || a.cols == 0
        scale_c(c, beta)
        return
    assert(holds(a.data.len, a.rows, a.cols, a.row_stride, a.col_stride), "a matrix reaches past the end of its data")
    assert(holds(b.data.len, b.rows, b.cols, b.row_stride, b.col_stride), "a matrix reaches past the end of its data")
    gemm_at[T, tri_all](alpha, a, b, beta, c, work)

/** The five loops at this target's tile and blocking, writing triangle `TRI` of C. */
private gemm_at[T: Real, const TRI: usize](alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T], work: GemmWork[T])
    gemm_blocked[T, vector_bytes / sizeof(T), tile_vectors, tile_cols, vector_bytes / sizeof(T) * tile_vectors * tile_cols, kc_bytes / sizeof(T), mc_bytes / sizeof(T), nc, TRI](alpha, a, b, beta, c, work)

// --- syrk ------------------------------------------------------------------------------------------
//
// syrk is gemm's five loops on `a` and `a.t()` writing one triangle of C: a block of A whose rows lie
// wholly outside the triangle against the current panel of B is not packed, a tile wholly outside it
// is not multiplied, and a tile on the diagonal is written back only inside it. So it does half of
// gemm's flops at gemm's speed, and the other triangle of C is neither read nor written.

/** The buffer sizes syrk needs for an `n` x `n` C and an `n` x `k` A. */
syrk_work_len[T: Real](n: usize, k: usize) -> GemmWorkLen = gemm_work_len[T](n, n, k)

/** `c := alpha * a * aᵀ + beta * c` on the `uplo` triangle of `c`, BLAS's `syrk`; pass `a.t()` for
 * `trans = 'T'` (`c := alpha * aᵀ * a + beta * c`). It packs into the caller's `work`
 * (`syrk_work_len` says how much).
 *
 * `c` is square and `a` has as many rows as `c`, or it traps. Only the `uplo` triangle of `c` (the
 * diagonal included) is read or written; the other is left bit for bit. As in the reference BLAS, a
 * `beta` of zero sets the triangle without reading it, and an `alpha` of zero or an `a` with no
 * columns only scales the triangle by `beta`, reading nothing of `a`. Buffers shorter than
 * `syrk_work_len` says trap, and so does a view built by hand that reaches past its data.
 */
syrk[T: Real](uplo: Uplo, alpha: T, a: Matrix[T], beta: T, c: MatrixMut[T], work: GemmWork[T])
    assert(c.rows == c.cols && a.rows == c.rows, "syrk's matrices do not agree in shape")
    assert(holds(c.data.len, c.rows, c.cols, c.row_stride, c.col_stride), "a matrix reaches past the end of its data")
    val need = syrk_work_len[T](c.rows, a.cols)
    assert(work.a.len >= need.a && work.b.len >= need.b, "syrk's packing buffers are shorter than syrk_work_len says")
    if c.rows == 0 then return
    val lower = uplo == Uplo.Lower
    if alpha == T.zero() || a.cols == 0
        scale_tri(lower, c, beta)
        return
    assert(holds(a.data.len, a.rows, a.cols, a.row_stride, a.col_stride), "a matrix reaches past the end of its data")
    if lower
        gemm_at[T, tri_lower](alpha, a, a.t(), beta, c, work)
    else
        gemm_at[T, tri_upper](alpha, a, a.t(), beta, c, work)

// --- Threads ---------------------------------------------------------------------------------------
//
// gemm_par runs the same five loops on the caller's workers. For each KC x NC panel of B it asks them
// twice: once to pack the panel, each job a run of its NR-wide panels into the shared buffer, and once
// to compute, each job a block of the panel's tiles — a run of whole MR row panels by a run of whole NR
// column panels — packing its own rows of A into its own slice of the A buffer. The return of each
// `each` is the barrier between the two. Every run starts on a multiple of MR or NR, and MC is a
// multiple of MR, so each tile of C is packed, multiplied and summed over k exactly as gemm does it:
// the result is bitwise the same for any number of workers.

/** The workers gemm_par runs its jobs on: the caller's pool, since this module starts no thread.
 *
 * An implementation marks its `each` `@scoped(job)` — the promise that every job has finished when
 * `each` returns — which is what lets gemm's jobs borrow the matrices rather than share them.
 * `sh.sysl.sblas.threads.Spawned` is one over `sysl.threads`.
 */
trait Workers
    /** How many jobs `each` runs; at least one. */
    count(*self) -> usize

    /** Runs `job(0)`, `job(1)`, …, `job(count() - 1)`, at once where it can, and returns when every
     * one of them has finished.
     */
    each(*self, job: &sync Fn(usize) -> unit)

/** The buffer sizes gemm_par needs on `workers` workers for the same problem as `gemm_work_len`: a
 * block of A for each worker, and the one shared panel of B.
 */
gemm_par_work_len[T: Real](m: usize, n: usize, k: usize, workers: usize) -> GemmWorkLen
    val one = gemm_work_len[T](m, n, k)
    GemmWorkLen(one.a * workers, one.b)

/** Run `w` of `parts` near-equal runs over `units`, as its first unit and the one past its last. */
private run_of(units: usize, parts: usize, w: usize) -> (usize, usize) = (w * units / parts, (w + 1) * units / parts)

/** The `tm` x `tn` grid of row runs by column runs, `tm * tn <= count`, over `pm` row panels and `pn`
 * column panels that makes the largest block smallest; of equal ones, the one with more row runs.
 */
private[sblas] par_grid(count: usize, pm: usize, pn: usize) -> (usize, usize)
    var best: (usize, usize) = (1, 1)
    var most = pm * pn
    for tm in 1..min(count, pm)
        val tn = min(count / tm, pn)
        val size = (pm + tm - 1) / tm * ((pn + tn - 1) / tn)
        if size <= most
            best = (tm, tn)
            most = size
    best

private gemm_par_blocked[T: Real, W: Workers, const V: usize, const MV: usize, const NR: usize, const TILE: usize, const KC: usize, const MC: usize, const NC: usize](workers: *W, alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T], work: GemmWork[T])
    val m = c.rows
    val n = c.cols
    val k = a.cols
    val count = workers.count()
    val need = work_len[T, V * MV, NR, KC, MC, NC](m, n, k)
    assert(work.a.len >= need.a * count && work.b.len >= need.b, "gemm_par's packing buffers are shorter than gemm_par_work_len says")
    val pm = (m + V * MV - 1) / (V * MV)
    var jc: usize = 0
    while jc < n
        val ncb = min(n - jc, NC)
        val pn = (ncb + NR - 1) / NR
        var pc: usize = 0
        while pc < k
            val kc = min(k - pc, KC)
            val beta_here = if pc == 0 then beta else T.one()
            workers.each((w) ->
                val (p0, p1) = run_of(pn, count, w)
                if p0 < p1
                    pack_b[T, V, NR](b, pc, kc, jc + p0 * NR, min(ncb - p0 * NR, (p1 - p0) * NR), work.b[p0 * NR * kc..<p1 * NR * kc]))
            val (tm, tn) = par_grid(count, pm, pn)
            workers.each((w) ->
                if w < tm * tn
                    val (r0, r1) = run_of(pm, tm, w / tn)
                    val (q0, q1) = run_of(pn, tn, w % tn)
                    val pa = work.a[w * need.a..<(w + 1) * need.a]
                    val i_end = min(r1 * V * MV, m)
                    val j_end = min(q1 * NR, ncb)
                    var tile: [TILE]T
                    var ic = r0 * V * MV
                    while ic < i_end
                        val mcb = min(i_end - ic, MC)
                        pack_a[T, V, V * MV](a, ic, mcb, pc, kc, pa)
                        var jr = q0 * NR
                        while jr < j_end
                            val bp = work.b[jr * kc..<(jr + NR) * kc]
                            var ir: usize = 0
                            while ir < mcb
                                micro[T, V, MV, NR](kc, pa[ir * kc..<(ir + V * MV) * kc], bp, tile[..])
                                write_back[T, V, V * MV](c, ic + ir, jc + jr, min(mcb - ir, V * MV), min(ncb - jr, NR), tile[..], alpha, beta_here)
                                ir += V * MV
                            jr += NR
                        ic += MC)
            pc += KC
        jc += NC

/** `c := alpha * a * b + beta * c` on the caller's `workers`, packing into `work`
 * (`gemm_par_work_len` with `workers.count()` says how much).
 *
 * Everything `gemm` says holds, and the result is bitwise the one `gemm` gives, for any number of
 * workers: each element of C is summed over k in the same order. A `workers.count()` of zero traps.
 */
gemm_par[T: Real, W: Workers](workers: *W, alpha: T, a: Matrix[T], b: Matrix[T], beta: T, c: MatrixMut[T], work: GemmWork[T])
    assert(a.rows == c.rows && b.cols == c.cols && a.cols == b.rows, "gemm's matrices do not agree in shape")
    assert(holds(c.data.len, c.rows, c.cols, c.row_stride, c.col_stride), "a matrix reaches past the end of its data")
    assert(workers.count() >= 1, "gemm_par needs at least one worker")
    if c.rows == 0 || c.cols == 0 then return
    if alpha == T.zero() || a.cols == 0
        scale_c(c, beta)
        return
    assert(holds(a.data.len, a.rows, a.cols, a.row_stride, a.col_stride), "a matrix reaches past the end of its data")
    assert(holds(b.data.len, b.rows, b.cols, b.row_stride, b.col_stride), "a matrix reaches past the end of its data")
    gemm_par_blocked[T, W, vector_bytes / sizeof(T), tile_vectors, tile_cols, vector_bytes / sizeof(T) * tile_vectors * tile_cols, kc_bytes / sizeof(T), mc_bytes / sizeof(T), nc](workers, alpha, a, b, beta, c, work)

// --- trsm ------------------------------------------------------------------------------------------
//
// `A X = B` is solved recursively. A is split into two diagonal blocks and the block beside them; the
// rows of B that the first diagonal block owns are solved, the other rows are updated by gemm with
// that solution, and the second diagonal block is solved — top first for a lower triangle, bottom
// first for an upper. Halving keeps gemm's shared dimension as deep as the problem allows, so for a
// large A nearly every flop is gemm's, in gemm's own packing buffers; only the diagonal blocks of at
// most `trsm_leaf` rows are solved by substitution. A right-hand solve is the left-hand one on the
// transposes: `X A = B` is `Aᵀ Xᵀ = Bᵀ`, and the transpose of one triangle is the other.

/** The order of the diagonal blocks solved by substitution, a multiple of MR at both widths, so that
 * the gemm updates between them start on whole tiles.
 */
private[sblas] const trsm_leaf: usize = 16

/** The block of `a` with `rows` x `cols` elements whose first is (`i0`, `j0`); it must not be empty. */
private block[T](a: Matrix[T], i0: usize, j0: usize, rows: usize, cols: usize) -> Matrix[T] = Matrix(a.data[i0 * a.row_stride + j0 * a.col_stride..], rows, cols, a.row_stride, a.col_stride)

/** The writable form of `block`. */
private block_mut[T](b: MatrixMut[T], i0: usize, j0: usize, rows: usize, cols: usize) -> MatrixMut[T] = MatrixMut(b.data[i0 * b.row_stride + j0 * b.col_stride..], rows, cols, b.row_stride, b.col_stride)

/** Solves `a x = b` in place by substitution, `a` being a triangle of at most `trsm_leaf` rows. Each
 * solved row is subtracted from the rows that still depend on it. A b whose rows are adjacent is solved
 * a column at a time in registers (`solve_leaf_columns`); otherwise the inner loop runs down b's
 * columns or along its rows, whichever are closer together, and along adjacent columns by vectors.
 */
private solve_leaf[T: Real](lower: bool, unit: bool, a: Matrix[T], b: MatrixMut[T])
    if b.row_stride == 1
        if lower
            solve_leaf_columns[T, vector_bytes / sizeof(T), trsm_leaf * sizeof(T) / vector_bytes, true](unit, a, b)
        else
            solve_leaf_columns[T, vector_bytes / sizeof(T), trsm_leaf * sizeof(T) / vector_bytes, false](unit, a, b)
        return
    val m = b.rows
    val n = b.cols
    var inv: [trsm_leaf]T
    for i in 0..<m
        inv[i] = if unit then T.one() else T.one() / a.at(i, i)
    val rs = b.row_stride
    val cs = b.col_stride
    val ars = a.row_stride
    val acs = a.col_stride
    @unchecked
        if rs <= cs
            for j in 0..<n
                val col = j * cs
                for s in 0..<m
                    val i = if lower then s else m - 1 - s
                    val x = b.data[col + i * rs] * inv[i]
                    b.data[col + i * rs] = x
                    val (lo, hi) = if lower then (i + 1, m) else (0, i)
                    for p in lo..<hi
                        val at = col + p * rs
                        b.data[at] = b.data[at] - a.data[p * ars + i * acs] * x
        else
            for s in 0..<m
                val i = if lower then s else m - 1 - s
                val row = i * rs
                if !unit
                    for j in 0..<n
                        b.data[row + j * cs] = b.data[row + j * cs] * inv[i]
                val (lo, hi) = if lower then (i + 1, m) else (0, i)
                for p in lo..<hi
                    val f = a.data[p * ars + i * acs]
                    val dst = p * rs
                    var j: usize = 0
                    if cs == 1
                        val v = vector_bytes / sizeof(T)
                        while j + v <= n
                            subtract_scaled[T, vector_bytes / sizeof(T)](b.data, dst + j, row + j, f)
                            j += v
                    while j < n
                        b.data[dst + j * cs] = b.data[dst + j * cs] - f * b.data[row + j * cs]
                        j += 1

/** `b[dst ..< dst + V] -= f * b[src ..< src + V]`, as one vector of V lanes. */
private subtract_scaled[T: Real, const V: usize](b: []T, dst: usize, src: usize, f: T)
    @unchecked
        val d: <V>T = b.load(dst)
        val s: <V>T = b.load(src)
        b.store(dst, s.mul_add(-f, d))

/** The leaf solve for a b whose rows are adjacent, a column at a time in registers.
 *
 * The triangle is first packed into `neg`: column `i` holds `-a[p, i]` for every row `p` that row `i` is
 * subtracted from — below it for a `LOWER` triangle, above it otherwise — and zeros elsewhere, so that
 * the other triangle and the diagonal are never read, and with them the rows past `m` of a leaf
 * shorter than `trsm_leaf`. Then each column of b is held as `trsm_leaf / V` vectors (a short one
 * through a zero-padded copy) and solved in order: row `i` is scaled by its diagonal's reciprocal, and
 * each whole vector of rows still to come takes `neg`'s column `i` times it in one fused multiply-add.
 * The rows still to come in row `i`'s own vector are updated one lane at a time, so a row already
 * solved is never touched: an infinity from a zero on the diagonal reaches exactly the rows the
 * reference substitution sends it to. A padding row has a reciprocal of zero and stays zero.
 */
private solve_leaf_columns[T: Real, const V: usize, const W: usize, const LOWER: bool](unit: bool, a: Matrix[T], b: MatrixMut[T])
    val m = b.rows
    var neg: [trsm_leaf * trsm_leaf]T
    var inv: [trsm_leaf]T
    for i in 0..<m
        inv[i] = if unit then T.one() else T.one() / a.at(i, i)
        val (lo, hi) = if LOWER then (i + 1, m) else (0, i)
        for p in lo..<hi
            neg[i * trsm_leaf + p] = -a.at(p, i)
    val cs = b.col_stride
    @unchecked
        for j in 0..<b.cols
            val col = j * cs
            var x: [W]<V>T
            if m == trsm_leaf
                for const w in 0..<W
                    x[w] = b.data.load(col + w * V)
            else
                var t: [trsm_leaf]T
                for i in 0..<m
                    t[i] = b.data[col + i]
                for const w in 0..<W
                    x[w] = t.load(w * V)
            for const s in 0..<trsm_leaf
                const i = if LOWER then s else trsm_leaf - 1 - s
                const lane = i % V
                const at = i / V
                val xi = x[at][lane] * inv[i]
                x[at][lane] = xi
                for const l in 0..<V
                    if const (LOWER && l > lane) || (!LOWER && l < lane)
                        x[at][l] = x[at][l] + neg[i * trsm_leaf + at * V + l] * xi
                for const w in 0..<W
                    if const (LOWER && w > at) || (!LOWER && w < at)
                        val c: <V>T = neg.load(i * trsm_leaf + w * V)
                        x[w] = c.mul_add(xi, x[w])
            if m == trsm_leaf
                for const w in 0..<W
                    b.data.store(col + w * V, x[w])
            else
                var t: [trsm_leaf]T
                for const w in 0..<W
                    t.store(w * V, x[w])
                for i in 0..<m
                    b.data[col + i] = t[i]

/** `b := a⁻¹ b` for a triangular `a` of b's rows, recursively as the section's comment describes. */
private trsm_left[T: Real](lower: bool, unit: bool, a: Matrix[T], b: MatrixMut[T], work: GemmWork[T])
    val m = b.rows
    if m <= trsm_leaf
        solve_leaf(lower, unit, a, b)
        return
    val n = b.cols
    val m1 = max(trsm_leaf, m / 2 / trsm_leaf * trsm_leaf)
    val m2 = m - m1
    val b1 = block_mut(b, 0, 0, m1, n)
    val b2 = block_mut(b, m1, 0, m2, n)
    if lower
        trsm_left(lower, unit, block(a, 0, 0, m1, m1), b1, work)
        gemm(-T.one(), block(a, m1, 0, m2, m1), b1.as_view(), T.one(), b2, work)
        trsm_left(lower, unit, block(a, m1, m1, m2, m2), b2, work)
    else
        trsm_left(lower, unit, block(a, m1, m1, m2, m2), b2, work)
        gemm(-T.one(), block(a, 0, m1, m1, m2), b2.as_view(), T.one(), b1, work)
        trsm_left(lower, unit, block(a, 0, 0, m1, m1), b1, work)

/** How many elements each of `GemmWork`'s two buffers needs for `trsm` on an `m` x `n` B: the triangle
 * is of order `m` on the `Left` and `n` on the `Right`. A triangle small enough to be solved without
 * gemm needs none.
 */
trsm_work_len[T: Real](side: Side, m: usize, n: usize) -> GemmWorkLen
    val (k, other) = side match
        Left -> (m, n)
        Right -> (n, m)
    if k <= trsm_leaf then GemmWorkLen(0, 0) else gemm_work_len[T](k, other, k)

/** Solves a triangular system for every column of `b` at once, in place: `b := alpha * a⁻¹ * b` on the
 * `Left`, `b := alpha * b * a⁻¹` on the `Right`, packing into the caller's `work` (`trsm_work_len` says
 * how much).
 *
 * `a` is square, of b's rows on the left and b's columns on the right. Only its `uplo` triangle is
 * read, and with `Diag.Unit` not its diagonal either, which is taken to be ones. `uplo` names the
 * triangle of the view as passed, so solving with the transpose of an upper-triangular matrix is
 * `trsm(side, Uplo.Lower, diag, alpha, a.t(), b, work)`. An `alpha` of zero sets b to zero without
 * reading it or `a`. As in the reference BLAS, a singular `a` is not detected: a zero on its diagonal
 * yields infinities and NaNs. Shapes that disagree trap, and so do buffers shorter than
 * `trsm_work_len` says and a view built by hand that reaches past its data.
 */
trsm[T: Real](side: Side, uplo: Uplo, diag: Diag, alpha: T, a: Matrix[T], b: MatrixMut[T], work: GemmWork[T])
    val k = side match
        Left -> b.rows
        Right -> b.cols
    assert(a.rows == k && a.cols == k, "trsm's matrices do not agree in shape")
    assert(holds(b.data.len, b.rows, b.cols, b.row_stride, b.col_stride), "a matrix reaches past the end of its data")
    val need = trsm_work_len[T](side, b.rows, b.cols)
    assert(work.a.len >= need.a && work.b.len >= need.b, "trsm's packing buffers are shorter than trsm_work_len says")
    if b.rows == 0 || b.cols == 0 then return
    scale_c(b, alpha)
    if alpha == T.zero() then return
    assert(holds(a.data.len, a.rows, a.cols, a.row_stride, a.col_stride), "a matrix reaches past the end of its data")
    val lower = uplo == Uplo.Lower
    val unit = diag == Diag.Unit
    side match
        Left -> trsm_left(lower, unit, a, b, work)
        Right -> trsm_left(!lower, unit, a.t(), b.t(), work)

// --- trmm ------------------------------------------------------------------------------------------
//
// trmm, `b := alpha * a * b` for a triangular `a`, is trsm's recursion run the other way. With A halved
// as trsm halves it, a lower A gives `B₂ := A₂₂ B₂ + A₂₁ B₁` and `B₁ := A₁₁ B₁`: B₂ is multiplied first
// (recursively), then takes `alpha A₂₁ B₁` from gemm while B₁ is still the caller's, and B₁ is
// multiplied last. An upper A is the mirror, B₁ first. So nearly all of the flops are gemm's, and only
// the `trsm_leaf`-row diagonal blocks are multiplied directly. The right side splits B's columns the
// same way (`trmm_right`). Either side is the other on the transposes, and the one run is the one that
// leaves gemm's C column-oriented: a column-major B on the right is not turned into a row-major one.

/** `b := alpha * a * b` in place, `a` being a triangle of at most `trsm_leaf` rows. A b whose rows are
 * adjacent is multiplied a column at a time in registers (`multiply_leaf_columns`). Otherwise each row
 * of the result is formed in place, in the order that reads only rows not yet overwritten — bottom up
 * for a lower triangle, top down for an upper — along adjacent columns by vectors where there are any.
 */
private multiply_leaf[T: Real](lower: bool, unit: bool, alpha: T, a: Matrix[T], b: MatrixMut[T])
    if b.row_stride == 1
        if lower
            multiply_leaf_columns[T, vector_bytes / sizeof(T), trsm_leaf * sizeof(T) / vector_bytes, true](unit, alpha, a, b)
        else
            multiply_leaf_columns[T, vector_bytes / sizeof(T), trsm_leaf * sizeof(T) / vector_bytes, false](unit, alpha, a, b)
        return
    val m = b.rows
    val n = b.cols
    val rs = b.row_stride
    val cs = b.col_stride
    val v = vector_bytes / sizeof(T)
    for s in 0..<m
        val i = if lower then m - 1 - s else s
        val d = if unit then alpha else alpha * a.at(i, i)
        val row = i * rs
        val (lo, hi) = if lower then (0, i) else (i + 1, m)
        @unchecked
            for j in 0..<n
                b.data[row + j * cs] = d * b.data[row + j * cs]
        for p in lo..<hi
            val f = alpha * a.at(i, p)
            val src = p * rs
            var j: usize = 0
            @unchecked
                if cs == 1
                    while j + v <= n
                        subtract_scaled[T, vector_bytes / sizeof(T)](b.data, row + j, src + j, -f)
                        j += v
                while j < n
                    b.data[row + j * cs] = f * b.data[src + j * cs] + b.data[row + j * cs]
                    j += 1

/** The leaf multiply for a b whose rows are adjacent, a column at a time in registers.
 *
 * The triangle is first packed into `tri`, times `alpha`: column `p` holds `alpha a[i, p]` for every row
 * `i` of the triangle — at and below the diagonal for a `LOWER` one, at and above it otherwise, the
 * diagonal being `alpha` itself when it is `unit` — and zeros elsewhere, so the other triangle is never
 * read, and nor are the rows past `m` of a leaf shorter than `trsm_leaf`. Each column of b is held as
 * `trsm_leaf / V` vectors (a short one through a zero-padded copy), and the product is summed over
 * columns `p` of `tri`: each whole vector of rows inside the triangle takes column `p` times `b[p]` in
 * one fused multiply-add, and the rows of `p`'s own vector one lane at a time, only those inside the
 * triangle, so an infinity in b reaches exactly the rows the reference product sends it to.
 */
private multiply_leaf_columns[T: Real, const V: usize, const W: usize, const LOWER: bool](unit: bool, alpha: T, a: Matrix[T], b: MatrixMut[T])
    val m = b.rows
    var tri: [trsm_leaf * trsm_leaf]T
    for p in 0..<m
        tri[p * trsm_leaf + p] = if unit then alpha else alpha * a.at(p, p)
        val (lo, hi) = if LOWER then (p + 1, m) else (0, p)
        for i in lo..<hi
            tri[p * trsm_leaf + i] = alpha * a.at(i, p)
    val cs = b.col_stride
    @unchecked
        for j in 0..<b.cols
            val col = j * cs
            var x: [W]<V>T
            if m == trsm_leaf
                for const w in 0..<W
                    x[w] = b.data.load(col + w * V)
            else
                var t: [trsm_leaf]T
                for i in 0..<m
                    t[i] = b.data[col + i]
                for const w in 0..<W
                    x[w] = t.load(w * V)
            var y: [W]<V>T
            for const w in 0..<W
                y[w] = T.zero()
            for const p in 0..<trsm_leaf
                const at = p / V
                const lane = p % V
                val xp = x[at][lane]
                for const w in 0..<W
                    if const (LOWER && w > at) || (!LOWER && w < at)
                        val c: <V>T = tri.load(p * trsm_leaf + w * V)
                        y[w] = c.mul_add(xp, y[w])
                for const l in 0..<V
                    if const (LOWER && l >= lane) || (!LOWER && l <= lane)
                        y[at][l] = y[at][l] + tri[p * trsm_leaf + at * V + l] * xp
            if m == trsm_leaf
                for const w in 0..<W
                    b.data.store(col + w * V, y[w])
            else
                var t: [trsm_leaf]T
                for const w in 0..<W
                    t.store(w * V, y[w])
                for i in 0..<m
                    b.data[col + i] = t[i]

/** `b := alpha * a * b` for a triangular `a` of b's rows, recursively as the section's comment says. */
private trmm_left[T: Real](lower: bool, unit: bool, alpha: T, a: Matrix[T], b: MatrixMut[T], work: GemmWork[T])
    val m = b.rows
    if m <= trsm_leaf
        multiply_leaf(lower, unit, alpha, a, b)
        return
    val n = b.cols
    val m1 = max(trsm_leaf, m / 2 / trsm_leaf * trsm_leaf)
    val m2 = m - m1
    val b1 = block_mut(b, 0, 0, m1, n)
    val b2 = block_mut(b, m1, 0, m2, n)
    if lower
        trmm_left(lower, unit, alpha, block(a, m1, m1, m2, m2), b2, work)
        gemm(alpha, block(a, m1, 0, m2, m1), b1.as_view(), T.one(), b2, work)
        trmm_left(lower, unit, alpha, block(a, 0, 0, m1, m1), b1, work)
    else
        trmm_left(lower, unit, alpha, block(a, 0, 0, m1, m1), b1, work)
        gemm(alpha, block(a, 0, m1, m1, m2), b2.as_view(), T.one(), b1, work)
        trmm_left(lower, unit, alpha, block(a, m1, m1, m2, m2), b2, work)

/** `b := alpha * b * a` in place, `a` being a triangle of at most `trsm_leaf` columns. A b whose columns
 * are contiguous is multiplied a column at a time: column `j` of the product is column `j` of b times
 * the diagonal plus the other columns of b the triangle's column `j` reaches, each an axpy, formed in
 * the order that reads only columns not yet overwritten — left to right for a lower triangle, right to
 * left for an upper. Otherwise it is the left-hand leaf on the transposes.
 */
private multiply_leaf_right[T: Real](lower: bool, unit: bool, alpha: T, a: Matrix[T], b: MatrixMut[T])
    if b.row_stride != 1
        multiply_leaf(!lower, unit, alpha, a.t(), b.t())
        return
    val m = b.rows
    val n = b.cols
    val cs = b.col_stride
    for s in 0..<n
        val j = if lower then s else n - 1 - s
        val d = if unit then alpha else alpha * a.at(j, j)
        val col = b.data[j * cs..<j * cs + m]
        @unchecked
            for i in 0..<m
                col[i] = d * col[i]
        val (lo, hi) = if lower then (j + 1, n) else (0, j)
        for p in lo..<hi
            axpy_kernel[T, block_bytes / sizeof(T)](alpha * a.at(p, j), b.data[p * cs..<p * cs + m], col)

/** `b := alpha * b * a` for a triangular `a` of b's columns. With b's columns halved as `trmm_left`
 * halves its rows, a lower A gives `B₁ := B₁ A₁₁ + B₂ A₂₁` and `B₂ := B₂ A₂₂`, so B₁ is multiplied
 * first, takes `alpha B₂ A₂₁` from gemm while B₂ is still the caller's, and B₂ is multiplied last; an
 * upper A is the mirror. It keeps C's columns as gemm's columns, which a column-major b needs.
 */
private trmm_right[T: Real](lower: bool, unit: bool, alpha: T, a: Matrix[T], b: MatrixMut[T], work: GemmWork[T])
    val n = b.cols
    if n <= trsm_leaf
        multiply_leaf_right(lower, unit, alpha, a, b)
        return
    val m = b.rows
    val n1 = max(trsm_leaf, n / 2 / trsm_leaf * trsm_leaf)
    val n2 = n - n1
    val b1 = block_mut(b, 0, 0, m, n1)
    val b2 = block_mut(b, 0, n1, m, n2)
    if lower
        trmm_right(lower, unit, alpha, block(a, 0, 0, n1, n1), b1, work)
        gemm(alpha, b2.as_view(), block(a, n1, 0, n2, n1), T.one(), b1, work)
        trmm_right(lower, unit, alpha, block(a, n1, n1, n2, n2), b2, work)
    else
        trmm_right(lower, unit, alpha, block(a, n1, n1, n2, n2), b2, work)
        gemm(alpha, b1.as_view(), block(a, 0, n1, n1, n2), T.one(), b2, work)
        trmm_right(lower, unit, alpha, block(a, 0, 0, n1, n1), b1, work)

/** How many elements each of `GemmWork`'s two buffers needs for `trmm` on an `m` x `n` B: nothing when
 * the triangle is small enough to be multiplied without gemm, and otherwise enough for gemm's updates
 * whichever way round B is split, since which it is depends on B's strides.
 */
trmm_work_len[T: Real](side: Side, m: usize, n: usize) -> GemmWorkLen
    val (k, other) = side match
        Left -> (m, n)
        Right -> (n, m)
    if k <= trsm_leaf then return GemmWorkLen(0, 0)
    val by_rows = gemm_work_len[T](k, other, k)
    val by_cols = gemm_work_len[T](other, k, k)
    GemmWorkLen(max(by_rows.a, by_cols.a), max(by_rows.b, by_cols.b))

/** Multiplies by a triangular matrix in place: `b := alpha * a * b` on the `Left`, `b := alpha * b * a`
 * on the `Right`, BLAS's `trmm`, packing into the caller's `work` (`trmm_work_len` says how much).
 *
 * `a` is square, of b's rows on the left and b's columns on the right. Only its `uplo` triangle is
 * read, and with `Diag.Unit` not its diagonal either, which is taken to be ones. `uplo` names the
 * triangle of the view as passed, so multiplying by the transpose of an upper-triangular matrix is
 * `trmm(side, Uplo.Lower, diag, alpha, a.t(), b, work)`. An `alpha` of zero sets b to zero without
 * reading it or `a`, as the reference does. Shapes that disagree trap, and so do buffers shorter than
 * `trmm_work_len` says and a view built by hand that reaches past its data.
 */
trmm[T: Real](side: Side, uplo: Uplo, diag: Diag, alpha: T, a: Matrix[T], b: MatrixMut[T], work: GemmWork[T])
    val k = side match
        Left -> b.rows
        Right -> b.cols
    assert(a.rows == k && a.cols == k, "trmm's matrices do not agree in shape")
    assert(holds(b.data.len, b.rows, b.cols, b.row_stride, b.col_stride), "a matrix reaches past the end of its data")
    val need = trmm_work_len[T](side, b.rows, b.cols)
    assert(work.a.len >= need.a && work.b.len >= need.b, "trmm's packing buffers are shorter than trmm_work_len says")
    if b.rows == 0 || b.cols == 0 then return
    if alpha == T.zero()
        scale_c(b, alpha)
        return
    assert(holds(a.data.len, a.rows, a.cols, a.row_stride, a.col_stride), "a matrix reaches past the end of its data")
    val lower = uplo == Uplo.Lower
    val unit = diag == Diag.Unit
    // Each side has its own recursion, and either is the other on the transposes; the one taken is the
    // one that keeps gemm's C with its rows closer together than its columns.
    val columns = b.row_stride <= b.col_stride
    side match
        Left -> if columns then trmm_left(lower, unit, alpha, a, b, work) else trmm_right(!lower, unit, alpha, a.t(), b.t(), work)
        Right -> if columns then trmm_right(lower, unit, alpha, a, b, work) else trmm_left(!lower, unit, alpha, a.t(), b.t(), work)
